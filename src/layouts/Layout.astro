---
import {
  Header,
  type HeaderLogo,
  type NavItem,
} from "@/components/custom/header";
import { Footer } from "@/components/custom/footer";
import { FloatingActions } from "@/components/custom/floating-actions";
import "@/styles/global.css";
import { getImage } from "astro:assets";
import {
  getNodes,
  getSiteSettings,
  isConfiguredContactValue,
} from "@/lib/content";
import type { ImageMetadata } from "astro";
import {
  whatsappLink,
  mailtoLink,
  DEFAULT_WHATSAPP_MESSAGE,
} from "@/lib/content";

const {
  title,
  description,
  ogImage,
  jsonLd,
  noindex = false,
  whatsappMessage = DEFAULT_WHATSAPP_MESSAGE,
} = Astro.props;

const nodes = await getNodes();
const settings = await getSiteSettings();
const configuredEmail = isConfiguredContactValue(settings.data.enquiryEmail)
  ? settings.data.enquiryEmail
  : "";
const configuredWhatsapp = isConfiguredContactValue(
  settings.data.defaultWhatsapp,
)
  ? settings.data.defaultWhatsapp
  : "";
const emailHref = configuredEmail
  ? mailtoLink(configuredEmail, "General ACOSA Enquiry")
  : "/contact";
const whatsappHref = configuredWhatsapp
  ? whatsappLink(configuredWhatsapp, whatsappMessage)
  : "/contact";

// Resolved here (server-only) because Header hydrates on the client via
// client:load — an async component like AcosaImage can't run in the
// browser, so the logo is pre-resolved to plain data via getImage().
async function resolveLogo(logo: { image: ImageMetadata; alt: string }) {
  const image = await getImage({
    src: logo.image,
    widths: [160, 240, 320],
    sizes: "160px",
  });
  return {
    src: image.src,
    srcSet: image.srcSet.attribute || undefined,
    sizes: image.attributes.sizes,
    width: image.attributes.width,
    height: image.attributes.height,
    alt: logo.alt,
  };
}

const logo: HeaderLogo | undefined = settings.data.logos
  ? {
      light: await resolveLogo(settings.data.logos.light),
      dark: await resolveLogo(settings.data.logos.dark),
    }
  : undefined;

export interface Props {
  title: string;
  description?: string;
  /** Resolved by the page (getImage → .src); relative paths are made
   *  absolute here, since social crawlers reject relative og:image. */
  ogImage?: string;
  /** Pre-built schema.org object (or array, emitted as an @graph). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  whatsappMessage?: string;
}

const navItems: NavItem[] = [
  {
    label: "Business Nodes",
    href: "/business-nodes",
    subItems: nodes.map((node) => ({
      label: node.data.name,
      href: `/business-nodes/${node.data.province}/${node.id}`,
    })),
  },
  { label: "Properties", href: "/properties" },
  { label: "Why ACOSA?", href: "/why-acosa" },
  { label: "For Companies", href: "/for-companies" },
  { label: "For Properties", href: "/list-your-property" },
  { label: "Contact", href: "/contact" },
];

const siteBase: string = import.meta.env.SITE || Astro.url.origin;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const canonicalUrl = new URL(Astro.url.pathname, siteBase).href;
// new URL() leaves an already-absolute ogImage untouched, so pages may pass
// either a getImage() src or a full URL.
const ogImageUrl = ogImage ? new URL(ogImage, siteBase).href : undefined;

// Sitewide baseline — rendered on every page, independent of the jsonLd prop.
const organisationSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "ACOSA",
  url: siteBase,
  description:
    "Vetted business accommodation across South Africa's key corporate nodes.",
  ...(configuredEmail ? { email: configuredEmail } : {}),
  sameAs: settings.data.socialLinks.map((s) => s.url).filter(Boolean),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {description && <meta name="description" content={description} />}
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    {description && <meta property="og:description" content={description} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="ACOSA" />

    <meta
      name="twitter:card"
      content={ogImageUrl ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <link rel="canonical" href={canonicalUrl} />

    {gaMeasurementId && (
      <script
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}
      />
    )}
    {gaMeasurementId && (
      <script is:inline define:vars={{ gaMeasurementId }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function() { window.dataLayer.push(arguments); };
        window.gtag("js", new Date());
        window.gtag("config", gaMeasurementId, { send_page_view: false });
      </script>
    )}

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Organisation schema: always present -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(organisationSchema)}
    />
    <!-- Page-level schema: passed by individual pages -->
    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(
            Array.isArray(jsonLd)
              ? { "@context": "https://schema.org", "@graph": jsonLd }
              : jsonLd,
          )}
        />
      )
    }
    <script is:inline>
      const getThemePreference = () => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      };
      const isDark = getThemePreference() === "dark";
      document.documentElement.classList[isDark ? "add" : "remove"]("dark");

      window.acosaTrack = function(eventName, payload = {}) {
        const queryParams = new URLSearchParams(window.location.search);
        const event = {
          event: eventName,
          page: window.location.pathname,
          referrer: document.referrer || undefined,
          utm_source: queryParams.get("utm_source") || undefined,
          utm_medium: queryParams.get("utm_medium") || undefined,
          utm_campaign: queryParams.get("utm_campaign") || undefined,
          ...payload,
          timestamp: new Date().toISOString(),
        };
        if (window.dataLayer) {
          window.dataLayer.push(event);
        }
        if (window.gtag) {
          window.gtag("event", eventName, payload);
        }
        return event;
      };

      document.addEventListener("click", (event) => {
        const target = event.target instanceof Element
          ? event.target.closest("[data-acosa-track]")
          : null;
        if (!target) return;
        const payload = {
          property_name: target.getAttribute("data-property-name") || undefined,
          property_id: target.getAttribute("data-property-id") || undefined,
          link: target.getAttribute("href") || undefined,
          label: target.getAttribute("data-acosa-track") || undefined,
        };
        window.acosaTrack(target.getAttribute("data-acosa-track") || "link_click", payload);
      });

      const propertyDetail = document.querySelector("[data-property-id]");
      if (propertyDetail?.getAttribute("data-property-page") === "true") {
        window.acosaTrack("property_view", {
          property_id: propertyDetail.getAttribute("data-property-id") || undefined,
          property_name: propertyDetail.getAttribute("data-property-name") || undefined,
        });
      }

      if (window.gtag) {
        window.acosaTrack("page_view", {
          page_title: document.title,
          page_location: window.location.href,
        });
      }

      if (typeof localStorage !== "undefined") {
        const observer = new MutationObserver(() => {
          const isDark = document.documentElement.classList.contains("dark");
          localStorage.setItem("theme", isDark ? "dark" : "light");
        });
        observer.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["class"],
        });
      }
    </script>
  </head>

  <body class="flex min-h-screen flex-col overflow-x-hidden antialiased">
    <Header navItems={navItems} logo={logo} client:load />
    <main class="size-full flex-1">
      <slot />
    </main>
    <Footer
      footerItems={navItems}
      logo={logo}
      description={settings.data.footerDescription}
      socials={settings.data.socialLinks}
      email={configuredEmail || "ACOSA contact email"}
      emailHref={emailHref}
      whatsappHref={whatsappHref}
      client:load
    />
    <FloatingActions
      whatsappHref={whatsappHref}
      whatsappLabel={"WhatsApp ACOSA"}
      client:load
    />
  </body>
</html>
