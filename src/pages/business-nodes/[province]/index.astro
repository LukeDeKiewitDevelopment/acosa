---
import Layout from "@/layouts/Layout.astro";
import {
  getNodes,
  getPropertiesByProvince,
  provinceLabel,
  buildNodeSummaries,
  buildPropertyListingItems,
} from "@/lib/content";
import { Section } from "@/components/custom/section";
import { SectionHeader } from "@/components/custom/section-header";
import { NodeChooser } from "@/components/custom/node-chooser";
import { PropertyGrid } from "@/components/custom/property-card";
import { CtaLink } from "@/components/custom/cta-link";
import { SectionNav } from "@/components/custom/section-nav";

export const prerender = true;

export async function getStaticPaths() {
  const nodes = await getNodes();
  const provinces = [...new Set(nodes.map((n) => n.data.province))];
  return provinces.map((province) => ({ params: { province } }));
}

const { province } = Astro.params;
const label = provinceLabel(province!);
const [nodes, properties] = await Promise.all([
  buildNodeSummaries(province!),
  getPropertiesByProvince(province!).then(buildPropertyListingItems),
]);
const hasNodes = nodes.length > 0;
const hasProperties = properties.length > 0;
---

<Layout
  title={`Business Accommodation in ${label} | ACOSA`}
  description={`Business accommodation in ${label}.`}
>
  <SectionNav
    client:load
    items={[
      { id: "business-nodes", label: "Business nodes" },
      ...(hasProperties ? [{ id: "properties", label: "Properties" }] : []),
    ]}
  />
  <Section
    id="business-nodes"
    tone="warm"
    spacing="none"
    className="pt-12 pb-16 md:pt-16 md:pb-24 lg:pt-20"
  >
    <div class="flex flex-col gap-10 md:gap-12">
      <SectionHeader
        as="h1"
        eyebrow="Business nodes"
        title={label}
        lead={`${nodes.length} business ${nodes.length === 1 ? "node" : "nodes"} · ${properties.length} ${properties.length === 1 ? "property" : "properties"}`}
      />
      {hasNodes && <NodeChooser items={nodes} />}
    </div>
  </Section>

  {
    hasProperties && (
      <Section id="properties">
        <div class="flex flex-col gap-10">
          <SectionHeader title={`Properties in ${label}`} />
          <PropertyGrid items={properties} />
        </div>
      </Section>
    )
  }

  {
    !hasNodes && !hasProperties && (
      <Section>
        <div class="mx-auto flex max-w-xl flex-col items-center gap-6 text-center">
          <p class="type-lead">No listings in {label} yet.</p>
          <CtaLink
            label="Back to Business Nodes"
            href="/business-nodes"
            variant="secondary"
            icon="arrow"
          />
        </div>
      </Section>
    )
  }
</Layout>
