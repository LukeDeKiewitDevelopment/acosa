---
import businessNodesHero from "@/assets/images/pages/business-nodes/hero.png";
import Layout from "@/layouts/Layout.astro";
import {
  getNodes,
  getActiveProvinces,
  getSiteSettings,
  whatsappLink,
} from "@/lib/content";
import { Section } from "@/components/custom/section";
import { Hero } from "@/components/custom/hero";
import {
  NodeDirectory,
  type DirectoryGroup,
  type DirectoryNode,
} from "@/components/custom/node-directory";

export const prerender = true;

const nodes = await getNodes();
const provinces = await getActiveProvinces();
const settings = await getSiteSettings();

const sortedProvinces = provinces.filter((province) => province.slug === "gauteng");

const directoryNodes: DirectoryNode[] = nodes.map((node) => ({
  id: node.id,
  name: node.data.name,
  province: node.data.province,
}));

const groups: DirectoryGroup[] = sortedProvinces.map((province) => ({
  slug: province.slug,
  label: province.label,
  nodeCount: province.nodeCount,
  nodes: directoryNodes.filter((node) => node.province === province.slug),
}));

const mapPositions: Record<string, { x: number; y: number; labelDy?: number }> = {
  bryanston: { x: 39, y: 18 },
  sandton: { x: 52, y: 24 },
  edenvale: { x: 70, y: 29 },
  midrand: { x: 30, y: 34, labelDy: -4 },
  "pretoria-east": { x: 54, y: 43 },
  centurion: { x: 28, y: 51 },
  rosslyn: { x: 18, y: 38, labelDy: 4 },
};
const mapNodes = nodes
  .filter((node) => node.data.province === "gauteng")
  .filter((node) => mapPositions[node.id])
  .map((node) => ({
    id: node.id,
    name: node.data.name,
    ...mapPositions[node.id],
  }));
---

<Layout
  title="Business Nodes | ACOSA"
  description="Find accommodation by location across South Africa's key business nodes."
>
  <Hero
    eyebrow="FIND ACCOMMODATION BY LOCATION"
    heading="Where do you need to do business?"
    body="Start with where you need to be. ACOSA brings together carefully selected accommodation around key South African business areas, helping you find options relevant to your destination rather than searching through hundreds of unrelated stays."
    primaryCta={{
      label: "Explore Business Nodes",
      href: "#directory",
    }}
    image={businessNodesHero}
    imageAlt="Business traveller arriving at curated accommodation"
    imageClassName="object-[72%_center] md:object-[68%_center] lg:object-center"
    overlay={{ color: "#000", opacity: 35 }}
  />

  <Section className="mt-28">
    <div class="mx-auto max-w-5xl">
      <div class="mb-6 text-center">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
          EXPLORE ACOSA'S BUSINESS NODES
        </p>
        <h2 class="mt-3 text-2xl font-bold text-primary md:text-3xl">
          Find accommodation where you need to do business.
        </h2>
      </div>

      <div class="rounded-3xl border border-border bg-card p-4 shadow-sm md:p-6">
        <div class="relative overflow-hidden rounded-2xl border border-border bg-[#f7f5f2] p-3 md:p-5">
          <svg viewBox="0 0 100 66" class="block h-auto min-h-80 w-full" role="img" aria-label="Gauteng business nodes map">
            <path d="M13 11 L31 7 L48 12 L67 8 L88 18 L94 39 L84 57 L60 62 L39 55 L20 59 L8 43 Z" fill="#e7e1d5" stroke="#d8cab2" stroke-width="0.8" />
            <path d="M17 49 C30 43 38 37 50 32 S72 21 88 20" fill="none" stroke="#c9bda3" stroke-width="1.2" stroke-dasharray="2 1.5" />
            <path d="M29 10 C34 23 34 34 39 55 M66 9 C63 23 65 42 60 61" fill="none" stroke="#d8cab2" stroke-width="0.7" />
            <text x="7" y="64" fill="#7d7468" font-size="2.8" font-weight="600">Gauteng business footprint</text>
            <text x="8" y="8" fill="#7d7468" font-size="2.8" font-weight="600">NORTH</text>
            <path d="M11 14 L11 9 M11 9 L9.5 11 M11 9 L12.5 11" fill="none" stroke="#7d7468" stroke-width="0.55" />
            <g>
              {mapNodes.map((node) => (
                <a
                  href={`/business-nodes/gauteng/${node.id}`}
                  class="group"
                  aria-label={`View ${node.name} business node`}
                >
                  <circle cx={node.x} cy={node.y} r="4.8" fill="transparent" />
                  <circle cx={node.x} cy={node.y} r="2.5" fill="#0e2a5a" stroke="#ffffff" stroke-width="0.8" class="transition-colors group-hover:fill-[#1f7a6b]" />
                  <text x={node.x + 3.8} y={node.y + (node.labelDy ?? -2)} fill="#0e2a5a" font-size="3.1" font-weight="700">{node.name}</text>
                </a>
              ))}
            </g>
          </svg>
        </div>
        <p class="text-muted-foreground mt-4 text-center text-xs md:text-sm">
          Select a node to view the accommodation available in that area.
        </p>
      </div>
    </div>
  </Section>

  <Section id="directory" className="mt-28">
    <NodeDirectory groups={groups} />
  </Section>

  <Section className="mt-28">
    <div class="space-y-8">
      <div class="flex flex-col gap-4 text-center">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
          Growing Network
        </p>
        <h2 class="text-primary text-2xl font-bold md:text-3xl">
          ACOSA is growing deliberately.
        </h2>
        <p class="mx-auto max-w-2xl text-sm text-muted-foreground md:text-base">
          We're building our accommodation network around quality, not simply quantity. New business nodes and carefully selected properties will be added as the ACOSA network expands.
        </p>
      </div>

      <div class="space-y-6">
        <div class="rounded-lg border border-border bg-card p-6">
          <p class="mb-4 text-sm font-medium">Can't see the area you need?</p>
          <a
            href={whatsappLink(
              settings.data.defaultWhatsapp,
              "Hi ACOSA, I'm looking for business accommodation in [AREA]. Can you assist?",
            )}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-full bg-green-600 px-6 py-2.5 text-sm font-medium text-white no-underline hover:bg-green-700"
          >
            Ask ACOSA
          </a>
        </div>

        <div class="rounded-lg border border-border bg-card p-6">
          <p class="mb-4 text-sm font-medium">
            Own a quality property in a business area?
          </p>
          <p class="mb-4 text-sm text-muted-foreground">
            We're building a curated network of independent accommodation providers that understand the needs of corporate travellers.
          </p>
          <a
            href="/list-your-property"
            class="inline-flex items-center justify-center rounded-full bg-primary px-6 py-2.5 text-sm font-medium text-primary-foreground no-underline hover:bg-primary/90"
          >
            List Your Property
          </a>
        </div>
      </div>
    </div>
  </Section>
</Layout>
