---
import southAfricaNetwork from "@/assets/images/pages/business-nodes/south-africa-network.png";
import businessNodesHero from "@/assets/images/pages/business-nodes/hero.png";
import Layout from "@/layouts/Layout.astro";
import ClosingImageSection from "@/components/custom/closing-image-section.astro";
import {
  getPublishedProperties,
  getSiteSettings,
  resolveCtaLink,
  buildNodeSummaries,
  buildPropertyListingItems,
} from "@/lib/content";
import { Hero } from "@/components/custom/hero";
import { Section } from "@/components/custom/section";
import { SectionHeader } from "@/components/custom/section-header";
import { CtaLink } from "@/components/custom/cta-link";
import { PropertyGrid } from "@/components/custom/property-card";
import { BusinessNodeExplorer } from "@/components/custom/business-node-explorer";
import { SectionNav } from "@/components/custom/section-nav";

export const prerender = true;

/* Business Nodes — Creative Direction Blueprint, Page 02.
   Hero (page heading + short orientation) → map and node selection →
   accommodation discovery → assistance if nothing suitable is found.
   A standard-height hero keeps the map reachable before the visitor scrolls far. */

const [nodes, properties, settings] = await Promise.all([
  buildNodeSummaries("gauteng"),
  getPublishedProperties().then(buildPropertyListingItems),
  getSiteSettings(),
]);

const askAcosaHref = resolveCtaLink("whatsapp", {
  email: settings.data.enquiryEmail,
  whatsappNumber: settings.data.defaultWhatsapp,
  whatsappMessage:
    "Hi ACOSA, I'm looking for business accommodation in [AREA]. Can you assist?",
});
---

<Layout
  title="Business Nodes | ACOSA"
  description="Find accommodation by location across South Africa's key business nodes."
>
  <Hero
    align="left"
    eyebrow="FIND ACCOMMODATION BY LOCATION"
    heading="Where do you need to do business?"
    body="Start with where you need to be. ACOSA brings together carefully selected accommodation around key South African business areas, helping you find options relevant to your destination rather than searching through hundreds of unrelated stays."
    primaryCta={{
      label: "Explore Business Nodes",
      href: "#directory",
    }}
    image={businessNodesHero}
    imageAlt="A business traveller arriving at curated accommodation"
    imageClassName="object-[78%_center] sm:object-[74%_center] lg:object-[70%_center]"
  />

  <SectionNav
    client:load
    items={[
      { id: "directory", label: "Business nodes" },
      ...(properties.length > 0
        ? [{ id: "accommodation", label: "Accommodation" }]
        : []),
      { id: "network", label: "Growing network" },
    ]}
  />

  {/* Map and node selection directly under the hero, working together. */}
  <Section id="directory" tone="warm">
    <div class="flex flex-col gap-8 md:gap-10">
      <SectionHeader
        eyebrow="EXPLORE ACOSA'S BUSINESS NODES"
        title="Find accommodation where you need to do business."
      />
      <BusinessNodeExplorer client:load nodes={nodes} />
    </div>
  </Section>

  {
    properties.length > 0 && (
      <Section id="accommodation">
        <div class="flex flex-col gap-10">
          <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
            <SectionHeader
              eyebrow="ACOSA PROPERTIES"
              title="Accommodation in the ACOSA network."
            />
            <CtaLink
              label="View all properties"
              href="/properties"
              variant="link"
            />
          </div>
          <PropertyGrid items={properties} />
        </div>
      </Section>
    )
  }

  <ClosingImageSection
    id="network"
    eyebrow="GROWING NETWORK"
    heading="ACOSA is growing deliberately."
    body="We're building our accommodation network around quality, not simply quantity. New business nodes and carefully selected properties will be added as the ACOSA network expands. Need help finding an area or want to add your property to the network? We'll help you take the next step."
    image={southAfricaNetwork}
    imageAlt=""
    actions={[
      {
        label: "Ask ACOSA",
        href: askAcosaHref,
        variant: "secondary",
        icon: "whatsapp",
        external: askAcosaHref.startsWith("http"),
        trackingKey: "nodes_ask_acosa_click",
      },
      {
        label: "List Your Property",
        href: "/list-your-property",
        variant: "link",
      },
    ]}
  />
</Layout>
