---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import {
  getPublishedProperties,
  getSiteSettings,
  resolveCtaLink,
  buildNodeSummaries,
  buildPropertyListingItems,
} from "@/lib/content";
import { Hero } from "@/components/custom/hero";
import { Section } from "@/components/custom/section";
import { SectionHeader } from "@/components/custom/section-header";
import { CtaLink } from "@/components/custom/cta-link";
import { PropertyGrid } from "@/components/custom/property-card";
import { BusinessNodeExplorer } from "@/components/custom/business-node-explorer";
import { SectionNav } from "@/components/custom/section-nav";
import ClosingImageSection from "@/components/custom/closing-image-section.astro";

export const prerender = true;

/* Business Nodes — Creative Direction Blueprint, Page 02.
   Hero (page heading + short orientation) → map and node selection →
   accommodation discovery → assistance if nothing suitable is found.
   A standard-height hero keeps the map reachable before the visitor scrolls far. */

const [nodes, properties, settings] = await Promise.all([
  buildNodeSummaries("gauteng"),
  getPublishedProperties().then(buildPropertyListingItems),
  getSiteSettings(),
]);
const directoryCopy = settings.data.directoryCopy.businessNodes;
const uiCopy = settings.data.uiCopy.businessNodes;

const askAcosaHref = resolveCtaLink("whatsapp", {
  email: settings.data.enquiryEmail,
  whatsappNumber: settings.data.defaultWhatsapp,
  whatsappMessage:
    "Hi ACOSA, I'm looking for business accommodation in [AREA]. Can you assist?",
});
---

<Layout title={directoryCopy.title} description={directoryCopy.description}>
  <Hero
    emphasizeBody
    align="left"
    eyebrow={directoryCopy.heroEyebrow}
    heading={directoryCopy.heroHeading}
    body={directoryCopy.heroBody}
    primaryCta={{
      label: directoryCopy.primaryCtaLabel,
      href: directoryCopy.primaryCtaLink,
    }}
    image={directoryCopy.heroImage}
    imageAlt="A business traveller arriving at curated accommodation"
    imageClassName="object-[78%_20%] sm:object-[74%_20%] lg:object-[70%_20%]"
  />

  <SectionNav
    client:load
    items={[
      { id: "directory", label: uiCopy.directoryNav },
      ...(properties.length > 0
        ? [{ id: "accommodation", label: uiCopy.accommodationNav }]
        : []),
      { id: "assistance", label: uiCopy.assistanceNav },
    ]}
  />

  {/* Map and node selection directly under the hero, working together. */}
  <Section
    id="directory"
    tone="warm"
    className="isolate overflow-hidden"
    containerClassName="relative z-10"
  >
    {
      directoryCopy.heroImage && (
        <Image
          src={directoryCopy.heroImage}
          format="webp"
          quality={75}
          loading="lazy"
          alt=""
          aria-hidden="true"
          widths={[768, 1200, 1600]}
          sizes="100vw"
          class="pointer-events-none absolute inset-0 z-0 h-full w-full object-cover object-[70%_center] opacity-20"
        />
      )
    }
    <div class="flex flex-col gap-8 md:gap-10">
      <SectionHeader
        eyebrow={directoryCopy.directoryEyebrow}
        title={directoryCopy.directoryHeading}
        underline
      />
      <BusinessNodeExplorer client:load nodes={nodes} />
    </div>
  </Section>

  {
    properties.length > 0 && (
      <Section id="accommodation">
        <div class="flex flex-col gap-10">
          <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
            <SectionHeader
              eyebrow={uiCopy.propertiesEyebrow}
              title={uiCopy.propertiesHeading}
              underline
            />
            <CtaLink
              label={uiCopy.propertiesNav}
              href="/properties"
              variant="link"
            />
          </div>
          <PropertyGrid items={properties} />
        </div>
      </Section>
    )
  }

  {
    directoryCopy.assistanceImage && (
      <ClosingImageSection
        id="assistance"
        eyebrow={directoryCopy.assistanceEyebrow}
        heading={directoryCopy.assistanceHeading}
        body={directoryCopy.assistanceBody}
        image={directoryCopy.assistanceImage}
        imageAlt="Business colleagues arriving for a project stay"
        actions={[
          {
            label: uiCopy.askLabel,
            href: askAcosaHref,
            variant: "secondary",
            icon: "whatsapp",
            external: askAcosaHref.startsWith("http"),
            trackingKey: "nodes_ask_acosa_click",
          },
        ]}
      />
    )
  }
</Layout>
