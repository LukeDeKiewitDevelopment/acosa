---
import { getImage } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import {
  getNodes,
  getActiveProvinces,
  buildSearchNodes,
  getSiteSettings,
  whatsappLink,
} from "@/lib/content";
import { Section } from "@/components/custom/section";
import { Hero } from "@/components/custom/hero";
import {
  NodeDirectory,
  type DirectoryGroup,
  type DirectoryNode,
} from "@/components/custom/node-directory";
import { BusinessNodeSearch } from "@/components/custom/business-node-search";

export const prerender = true;

const nodes = await getNodes();
const provinces = await getActiveProvinces();
const settings = await getSiteSettings();
const searchNodes = await buildSearchNodes();

const sortedProvinces = [...provinces].sort(
  (a, b) => b.nodeCount - a.nodeCount || a.label.localeCompare(b.label),
);

const directoryNodes: DirectoryNode[] = await Promise.all(
  nodes.map(async (node) => {
    const img = await getImage({
      src: node.data.heroImage,
      widths: [400, 800],
      sizes: "(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw",
    });
    return {
      id: node.id,
      name: node.data.name,
      city: node.data.city,
      province: node.data.province,
      image: {
        src: img.src,
        srcSet: img.srcSet.attribute || undefined,
        sizes: img.attributes.sizes,
        width: img.attributes.width,
        height: img.attributes.height,
      },
      imageAlt: node.data.imageAlt || node.data.name,
    };
  }),
);

const groups: DirectoryGroup[] = sortedProvinces.map((province) => ({
  slug: province.slug,
  label: province.label,
  nodeCount: province.nodeCount,
  nodes: directoryNodes.filter((node) => node.province === province.slug),
}));
---

<Layout
  title="Business Nodes | ACOSA"
  description="Find accommodation by location across South Africa's key business nodes."
>
  <Hero
    eyebrow="FIND ACCOMMODATION BY LOCATION"
    heading="Where do you need to do business?"
    body="Start with where you need to be. ACOSA brings together carefully selected accommodation around key South African business areas, helping you find options relevant to your destination rather than searching through hundreds of unrelated stays."
    primaryCta={{
      label: "Explore Business Nodes",
      href: "#directory",
    }}
  />

  <Section id="directory" className="mt-28">
    <NodeDirectory groups={groups} />
  </Section>

  <Section className="mt-28">
    <div class="space-y-8">
      <div class="flex flex-col gap-4 text-center">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
          Growing Network
        </p>
        <h2 class="text-primary text-2xl font-bold md:text-3xl">
          ACOSA is growing deliberately.
        </h2>
        <p class="mx-auto max-w-2xl text-sm text-muted-foreground md:text-base">
          We're building our accommodation network around quality, not simply quantity. New business nodes and carefully selected properties will be added as the ACOSA network expands.
        </p>
      </div>

      <div class="space-y-6">
        <div class="rounded-lg border border-border bg-card p-6">
          <p class="mb-4 text-sm font-medium">Can't see the area you need?</p>
          <a
            href={whatsappLink(
              settings.data.defaultWhatsapp,
              "Hi ACOSA, I'm looking for business accommodation in [AREA]. Can you assist?",
            )}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-full bg-green-600 px-6 py-2.5 text-sm font-medium text-white no-underline hover:bg-green-700"
          >
            Ask ACOSA
          </a>
        </div>

        <div class="rounded-lg border border-border bg-card p-6">
          <p class="mb-4 text-sm font-medium">
            Own a quality property in a business area?
          </p>
          <p class="mb-4 text-sm text-muted-foreground">
            We're building a curated network of independent accommodation providers that understand the needs of corporate travellers.
          </p>
          <a
            href="/list-your-property"
            class="inline-flex items-center justify-center rounded-full bg-primary px-6 py-2.5 text-sm font-medium text-primary-foreground no-underline hover:bg-primary/90"
          >
            List Your Property
          </a>
        </div>
      </div>
    </div>
  </Section>
</Layout>
