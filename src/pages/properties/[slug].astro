---
import { render } from "astro:content";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "@/layouts/Layout.astro";
import {
  getPublishedProperties,
  resolvePropertyTags,
  getTestimonialsForProperty,
  propertyTypeLabel,
  provinceLabel,
  NODE_MAP_COORDINATES,
} from "@/lib/content";
import { ContourTexture } from "@/components/custom/map-graphics";
import { getEntry } from "astro:content";
import { Section } from "@/components/custom/section";
import {
  PropertyGallery,
  type PropertyGallerySlide,
} from "@/components/custom/property-gallery";
import { PropertyDetail } from "@/components/custom/property-detail";

export const prerender = true;

export async function getStaticPaths() {
  const properties = await getPublishedProperties();
  return properties.map((property) => ({
    params: { slug: property.id },
    props: { property },
  }));
}

const { property } = Astro.props;
const { Content } = await render(property);
const { essentials, facilities, nearbyConvenience, perfectFor } =
  await resolvePropertyTags(property);
const testimonials = await getTestimonialsForProperty(property.id);
const seo = property.data.seo;
const businessNode = await getEntry(property.data.businessNode);

// Cast: seoFields() in content.config.ts types image() as ZodTypeAny, which
// erases ImageMetadata from the inferred schema. The runtime value is one.
const ogImageUrl = seo?.ogImage
  ? (
      await getImage({
        src: seo.ogImage as ImageMetadata,
        width: 1200,
        height: 630,
      })
    ).src
  : undefined;

const siteBase: string = import.meta.env.SITE || Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteBase).href;

const propertySchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  name: property.data.name,
  url: canonicalUrl,
  description: seo?.description || property.data.shortDescription,
  address: {
    "@type": "PostalAddress",
    // JSON.stringify drops undefined keys, so an absent address is omitted.
    streetAddress: property.data.location?.address || undefined,
    addressRegion: provinceLabel(property.data.province),
    addressCountry: "ZA",
  },
  // No numerical score is published (Creative Direction Blueprint, Page 04).
  ...(property.data.acosaApproved.approved ? { award: "ACOSA Approved" } : {}),
  ...(property.data.contact.email
    ? { email: property.data.contact.email }
    : {}),
  ...(property.data.contact.phone
    ? { telephone: property.data.contact.phone }
    : {}),
  ...(property.data.location?.mapUrl
    ? { hasMap: property.data.location.mapUrl }
    : {}),
};

// Slides = heroImage first, then gallery[] in order.
const slideSources = [
  {
    image: property.data.heroImage,
    alt: property.data.imageAlt || property.data.name,
  },
  ...property.data.gallery.map((entry) => ({
    image: entry.image,
    alt: entry.alt || property.data.name,
  })),
];

const slides: PropertyGallerySlide[] = await Promise.all(
  slideSources.map(async (slide) => {
    const img = await getImage({
      src: slide.image,
      widths: [480, 800, 1200, 1600],
      sizes: "(min-width: 1024px) 50vw, 100vw",
    });
    return {
      image: {
        src: img.src,
        srcSet: img.srcSet.attribute || undefined,
        sizes: img.attributes.sizes,
        width: img.attributes.width,
        height: img.attributes.height,
      },
      alt: slide.alt,
    };
  }),
);
---

<Layout
  title={seo?.title || `${property.data.name} | ACOSA`}
  description={seo?.description ||
    property.data.shortDescription ||
    `${propertyTypeLabel(property.data.propertyType)} business accommodation at ${property.data.name}.`}
  ogImage={ogImageUrl}
  jsonLd={propertySchema}
>
  <Section
    tone="warm"
    spacing="none"
    className="overflow-hidden pt-6 pb-10 md:pt-8 md:pb-12 lg:pt-10"
    containerClassName="relative"
  >
    <ContourTexture className="text-sage" />
    <nav
      aria-label="Breadcrumb"
      class="type-small mb-5 flex flex-wrap items-center gap-2 text-xs"
    >
      <a
        href="/properties"
        class="text-muted-foreground hover:text-foreground no-underline"
        >Properties</a
      >
      <span aria-hidden="true">/</span>
      <span class="text-foreground">{property.data.name}</span>
    </nav>
    <PropertyGallery
      client:load
      slides={slides}
      propertyName={property.data.name}
    />
  </Section>

  <Section
    spacing="none"
    className="pt-10 pb-16 md:pt-14 md:pb-24 lg:pt-16 lg:pb-28"
  >
    <PropertyDetail
      property={{
        id: property.id,
        name: property.data.name,
        propertyTypeLabel: propertyTypeLabel(property.data.propertyType),
        businessNodeLabel: businessNode?.data.name ?? "",
        provinceLabel: provinceLabel(property.data.province),
        approved: property.data.acosaApproved.approved,
        shortDescription: property.data.shortDescription,
        address: property.data.location.address,
        mapUrl: property.data.location.mapUrl ?? "",
        whatsapp: property.data.contact.whatsapp,
        phone: property.data.contact.phone,
        email: property.data.contact.email,
        website: property.data.contact.website ?? undefined,
        mapPin: NODE_MAP_COORDINATES[property.data.businessNode.id]
          ? {
              longitude: NODE_MAP_COORDINATES[property.data.businessNode.id][0],
              latitude: NODE_MAP_COORDINATES[property.data.businessNode.id][1],
              label: businessNode?.data.name,
            }
          : undefined,
      }}
      essentials={essentials.map((tag) => ({
        name: tag.data.name,
        icon: tag.data.icon,
      }))}
      perfectFor={perfectFor.map((tag) => ({
        name: tag.data.name,
        icon: tag.data.icon,
      }))}
      facilities={facilities.map((tag) => ({
        name: tag.data.name,
        icon: tag.data.icon,
      }))}
      nearby={nearbyConvenience.map((tag) => ({
        name: tag.data.name,
        icon: tag.data.icon,
      }))}
      testimonials={testimonials.map((testimonial) => ({
        reviewer: testimonial.data.reviewer,
        review: testimonial.data.review,
        rating: testimonial.data.rating,
      }))}
    >
      <Content />
    </PropertyDetail>
  </Section>
</Layout>
