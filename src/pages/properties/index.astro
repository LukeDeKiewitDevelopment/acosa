---
import { getImage } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import { Section } from "@/components/custom/section";
import { getPublishedProperties, propertyTypeLabel } from "@/lib/content";
import {
  PropertySearch,
  type PropertySearchItem,
} from "@/components/custom/property-search";

export const prerender = true;

const properties = await getPublishedProperties();

const items: PropertySearchItem[] = await Promise.all(
  properties.map(async (property) => {
    const img = await getImage({
      src: property.data.heroImage,
      widths: [400, 800],
      sizes: "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw",
    });
    return {
      id: property.id,
      name: property.data.name,
      province: property.data.province,
      propertyType: property.data.propertyType,
      propertyTypeLabel: propertyTypeLabel(property.data.propertyType),
      approved: property.data.acosaApproved.approved,
      shortDescription: property.data.shortDescription,
      image: {
        src: img.src,
        srcSet: img.srcSet.attribute || undefined,
        sizes: img.attributes.sizes,
        width: img.attributes.width,
        height: img.attributes.height,
      },
      imageAlt: property.data.imageAlt || property.data.name,
    };
  }),
);
---

<Layout title="All Properties | Acosa">
  <Section className="mt-28">
    <h1 class="text-primary text-2xl font-bold md:text-3xl lg:text-4xl">
      All Properties
    </h1>
    <p class="text-muted-foreground mt-2 text-sm md:text-base">
      Browse business accommodation across South Africa's key corporate nodes.
    </p>
  </Section>
  <Section className="mt-16 mb-28">
    <PropertySearch client:load items={items} />
  </Section>
</Layout>
