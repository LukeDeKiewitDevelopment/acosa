---
import Layout from "@/layouts/Layout.astro";
import { Section } from "@/components/custom/section";
import ClosingImageSection from "@/components/custom/closing-image-section.astro";
import {
  getNodes,
  getPublishedProperties,
  getSiteSettings,
  buildPropertyListingItems,
  buildNodeSummaries,
} from "@/lib/content";
import { PropertiesMapHero } from "@/components/custom/properties-map-hero";
import { PropertySearch } from "@/components/custom/property-search";
import { SectionNav } from "@/components/custom/section-nav";

export const prerender = true;

/* Properties — Creative Direction Blueprint, Page 03.
   Cohesive search, then genuine listings. No invented inventory: a single
   listing is presented as a feature, followed by an honest growing-network
   note. */

const [items, nodes, mapNodes, settings] = await Promise.all([
  getPublishedProperties().then(buildPropertyListingItems),
  getNodes(),
  buildNodeSummaries("gauteng"),
  getSiteSettings(),
]);
const businessNodes = nodes.map((node) => ({
  id: node.id,
  name: node.data.name,
}));
const directoryCopy = settings.data.directoryCopy.properties;
---

<Layout title={directoryCopy.title} description={directoryCopy.description}>
  <PropertiesMapHero
    eyebrow={directoryCopy.heroEyebrow}
    title={directoryCopy.heading}
    lead={directoryCopy.lead}
    regionLabel={directoryCopy.regionLabel}
    nodes={mapNodes}
    propertyCount={items.length}
  />

  <SectionNav
    client:load
    items={[
      { id: "property-search", label: directoryCopy.searchNavLabel },
      { id: "network", label: directoryCopy.networkNavLabel },
    ]}
  />

  <Section
    id="property-search"
    spacing="none"
    className="pt-10 pb-16 md:pt-12 md:pb-24 lg:pb-28"
  >
    <PropertySearch client:load items={items} businessNodes={businessNodes} />
  </Section>
  {
    directoryCopy.networkImage && (
      <ClosingImageSection
        id="network"
        eyebrow={directoryCopy.networkEyebrow}
        heading={directoryCopy.networkHeading}
        underlineHeading
        body={directoryCopy.networkBody}
        image={directoryCopy.networkImage}
        mobileImageFit="contain"
        imageAlt=""
        actions={[
          {
            label: directoryCopy.networkCtaLabel,
            href: directoryCopy.networkCtaLink,
            variant: "secondary",
            icon: "arrow",
          },
        ]}
      />
    )
  }
</Layout>
