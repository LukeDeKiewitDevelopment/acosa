---
import Layout from "@/layouts/Layout.astro";
import { Section } from "@/components/custom/section";
import { SectionHeader } from "@/components/custom/section-header";
import { CtaLink } from "@/components/custom/cta-link";
import {
  getNodes,
  getPublishedProperties,
  buildPropertyListingItems,
} from "@/lib/content";
import { PropertySearch } from "@/components/custom/property-search";

export const prerender = true;

/* Properties — Creative Direction Blueprint, Page 03.
   Cohesive search, then genuine listings. No invented inventory: a single
   listing is presented as a feature, followed by an honest growing-network
   note. */

const [items, nodes] = await Promise.all([
  getPublishedProperties().then(buildPropertyListingItems),
  getNodes(),
]);
const businessNodes = nodes.map((node) => ({
  id: node.id,
  name: node.data.name,
}));
---

<Layout
  title="All Properties | ACOSA"
  description="Browse vetted business accommodation properties across South Africa."
>
  <Section
    tone="warm"
    spacing="none"
    className="pt-12 pb-12 md:pt-16 md:pb-16 lg:pt-20"
  >
    <SectionHeader
      as="h1"
      eyebrow="ACOSA PROPERTIES"
      title="All Properties"
      lead="Browse business accommodation across South Africa's key corporate nodes."
    />
  </Section>

  <Section spacing="none" className="pt-10 pb-16 md:pt-12 md:pb-24 lg:pb-28">
    <div class="flex flex-col gap-14">
      <PropertySearch client:load items={items} businessNodes={businessNodes} />

      <div
        class="border-border flex flex-col gap-5 border-t pt-10 md:flex-row md:items-center md:justify-between"
      >
        <div class="flex max-w-2xl flex-col gap-2">
          <h2 class="type-h3">ACOSA is growing deliberately.</h2>
          <p class="type-body">
            We're building our accommodation network around quality, not simply
            quantity. New business nodes and carefully selected properties will
            be added as the ACOSA network expands.
          </p>
        </div>
        <CtaLink
          label="Explore Business Nodes"
          href="/business-nodes"
          variant="link"
          className="shrink-0"
        />
      </div>
    </div>
  </Section>
</Layout>
