---
import southAfricaNetwork from "@/assets/images/pages/business-nodes/south-africa-network.png";
import Layout from "@/layouts/Layout.astro";
import { Section } from "@/components/custom/section";
import ClosingImageSection from "@/components/custom/closing-image-section.astro";
import {
  getNodes,
  getPublishedProperties,
  buildPropertyListingItems,
  buildNodeSummaries,
} from "@/lib/content";
import { PropertiesMapHero } from "@/components/custom/properties-map-hero";
import { PropertySearch } from "@/components/custom/property-search";
import { SectionNav } from "@/components/custom/section-nav";

export const prerender = true;

/* Properties — Creative Direction Blueprint, Page 03.
   Cohesive search, then genuine listings. No invented inventory: a single
   listing is presented as a feature, followed by an honest growing-network
   note. */

const [items, nodes, mapNodes] = await Promise.all([
  getPublishedProperties().then(buildPropertyListingItems),
  getNodes(),
  buildNodeSummaries("gauteng"),
]);
const businessNodes = nodes.map((node) => ({
  id: node.id,
  name: node.data.name,
}));
---

<Layout
  title="All Properties | ACOSA"
  description="Browse vetted business accommodation properties across South Africa."
>
  <PropertiesMapHero
    eyebrow="ACOSA PROPERTIES"
    title="All Properties"
    lead="Browse business accommodation across South Africa's key corporate nodes."
    regionLabel="Gauteng"
    nodes={mapNodes}
    propertyCount={items.length}
  />

  <SectionNav
    client:load
    items={[
      { id: "property-search", label: "Search properties" },
      { id: "network", label: "Growing network" },
    ]}
  />

  <Section
    id="property-search"
    spacing="none"
    className="pt-10 pb-16 md:pt-12 md:pb-24 lg:pb-28"
  >
    <PropertySearch client:load items={items} businessNodes={businessNodes} />
  </Section>
  <ClosingImageSection
    id="network"
    eyebrow="GROWING NETWORK"
    heading="ACOSA is growing deliberately."
    body="We're building our accommodation network around quality, not simply quantity. New business nodes and carefully selected properties will be added as the ACOSA network expands."
    image={southAfricaNetwork}
    imageAlt=""
    actions={[
      {
        label: "Explore Business Nodes",
        href: "/business-nodes",
        variant: "secondary",
        icon: "arrow",
      },
    ]}
  />
</Layout>
