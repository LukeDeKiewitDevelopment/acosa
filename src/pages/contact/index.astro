---
import Layout from "@/layouts/Layout.astro";
import { getEntry } from "astro:content";
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import {
  getSiteSettings,
  whatsappLink,
  mailtoLink,
  isConfiguredContactValue,
} from "@/lib/content";
import { Section } from "@/components/custom/section";
import { SectionHeader } from "@/components/custom/section-header";
import { CtaLink } from "@/components/custom/cta-link";
import { IconMark } from "@/components/custom/icon-mark";
import { BedDouble, Building2, CircleHelp, House } from "lucide-react";

// Each route's icon identifies the enquiry type, matched on its CMS title.
const routeIcon = (title: string) =>
  /list|property/i.test(title)
    ? House
    : /company|team/i.test(title)
      ? Building2
      : /accommodation/i.test(title)
        ? BedDouble
        : CircleHelp;

/* Contact — Creative Direction Blueprint, Page 08, with the later
   improvement brief's hero image: a standard (not cinematic) hero that puts
   WhatsApp first, then four clearly differentiated enquiry routes with one
   consistent contact treatment, then ACOSA on LinkedIn. */

export const prerender = true;

const page = await getEntry("contactPage", "contact");
if (!page) throw new Error("Contact page content not found");
const settings = await getSiteSettings();
const { hero, contactRoutes } = page.data;
const seo = page.data.seo;

// Cast: seoFields() in content.config.ts types image() as ZodTypeAny, which
// erases ImageMetadata from the inferred schema. The runtime value is one.
const ogImageUrl = seo?.ogImage
  ? (
      await getImage({
        src: seo.ogImage as ImageMetadata,
        width: 1200,
        height: 630,
      })
    ).src
  : undefined;

const email = settings.data.enquiryEmail;
const configuredEmail = isConfiguredContactValue(email) ? email : "";
const configuredWhatsapp = isConfiguredContactValue(
  settings.data.defaultWhatsapp,
)
  ? settings.data.defaultWhatsapp
  : "";
const routeHref = (link: string, subject?: string, message?: string) =>
  link === "email"
    ? configuredEmail
      ? mailtoLink(configuredEmail, subject || "General ACOSA Enquiry")
      : "/contact"
    : link === "whatsapp"
      ? configuredWhatsapp
        ? whatsappLink(configuredWhatsapp, message)
        : "/contact"
      : link;

const heroWhatsappHref = routeHref(
  "whatsapp",
  undefined,
  "Hi ACOSA, I'd like to ask a question about accommodation and/or listing opportunities.",
);
const linkedin = settings.data.socialLinks.find((social) =>
  /linkedin/i.test(`${social.label} ${social.url}`),
);
---

<Layout
  title={seo?.title || "Contact ACOSA"}
  description={seo?.description ||
    "Get in touch with ACOSA about business accommodation in South Africa."}
  ogImage={ogImageUrl}
>
  {/* Split header: the photo has two people, so copy never sits over it. */}
  <section class="surface-navy grid lg:min-h-[34rem] lg:grid-cols-2">
    <div class="order-last flex items-center lg:order-first">
      <div
        class="flex w-full max-w-xl flex-col gap-5 px-4 py-12 sm:px-6 md:py-16 lg:ml-auto lg:pr-14 lg:pl-10"
      >
        {hero.eyebrow && <p class="eyebrow-accent">{hero.eyebrow}</p>}
        <h1 class="type-h1">{hero.heading}</h1>
        <p class="type-lead">{hero.body}</p>
        <div
          class="mt-3 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-6"
        >
          <CtaLink
            label="WhatsApp ACOSA"
            href={heroWhatsappHref}
            variant="primary"
            size="lg"
            icon="whatsapp"
            external={heroWhatsappHref.startsWith("http")}
            trackingKey="contact_hero_whatsapp_click"
            className="w-full sm:w-auto"
          />
          {
            configuredEmail && (
              <CtaLink
                label="Email ACOSA"
                href={mailtoLink(configuredEmail, "General ACOSA Enquiry")}
                variant="link"
                icon="email"
                trackingKey="contact_hero_email_click"
              />
            )
          }
        </div>
      </div>
    </div>
    {
      hero.image && (
        <div class="relative aspect-4/3 sm:aspect-video lg:aspect-auto">
          <Image
            src={hero.image}
            alt="An ACOSA host talking a business traveller through her stay"
            widths={[480, 800, 1200, 1408]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            loading="eager"
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover object-[45%_center]"
          />
        </div>
      )
    }
  </section>

  <Section>
    <div class="flex flex-col gap-10 md:gap-12">
      <SectionHeader
        eyebrow="Choose the right route"
        title="Which option applies to you?"
      />

      <ol class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5">
        {
          contactRoutes.map((route) => {
            const primary = route.primaryCta || route.cta;
            const secondary = route.secondaryCta;
            const icon = (link: string) =>
              link === "whatsapp"
                ? "whatsapp"
                : link === "email"
                  ? "email"
                  : "arrow";
            return (
              <li
                data-reveal
                style={`--reveal-index: ${Number(route.number) - 1}`}
                class="bg-card border-border hover:border-foreground/30 flex flex-col gap-6 rounded-xl border p-6 transition-[border-color,box-shadow] duration-200 hover:shadow-[0_18px_40px_-28px_rgb(5_10_60/0.4)] md:p-8"
              >
                <div class="flex flex-col gap-2">
                  <IconMark icon={routeIcon(route.title)} className="mb-2" />
                  <h2 class="type-h3">{route.title}</h2>
                  <p class="type-body">{route.description}</p>
                </div>
                <div class="mt-auto flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center sm:gap-6">
                  {primary && (
                    <CtaLink
                      label={primary.label}
                      href={routeHref(
                        primary.link,
                        primary.subject,
                        primary.prefilledMessage,
                      )}
                      variant="secondary"
                      icon={icon(primary.link)}
                      external={
                        primary.link === "whatsapp" &&
                        Boolean(configuredWhatsapp)
                      }
                      trackingKey={`contact_route_${route.number}_click`}
                      className="w-full sm:w-auto"
                    />
                  )}
                  {secondary && (
                    <CtaLink
                      label={secondary.label}
                      href={routeHref(
                        secondary.link,
                        undefined,
                        secondary.prefilledMessage,
                      )}
                      variant="link"
                      icon={icon(secondary.link)}
                      external={
                        secondary.link === "whatsapp" &&
                        Boolean(configuredWhatsapp)
                      }
                      trackingKey={`contact_route_${route.number}_secondary_click`}
                      className="text-sm"
                    />
                  )}
                </div>
                {route.number === "4" && configuredEmail && (
                  <p class="type-small border-border border-t pt-4">
                    Direct email:{" "}
                    <a
                      href={`mailto:${configuredEmail}`}
                      class="text-foreground font-medium"
                    >
                      {configuredEmail}
                    </a>
                  </p>
                )}
              </li>
            );
          })
        }
      </ol>

      {
        linkedin && (
          <div class="border-border flex flex-col gap-4 border-t pt-8 sm:flex-row sm:items-center sm:justify-between">
            <h2 class="type-h3">Follow ACOSA</h2>
            <CtaLink
              label="ACOSA on LinkedIn"
              href={linkedin.url}
              variant="secondary"
              icon="external"
              external
              trackingKey="contact_linkedin_click"
              className="w-full sm:w-auto"
            />
          </div>
        )
      }
    </div>
  </Section>
</Layout>
