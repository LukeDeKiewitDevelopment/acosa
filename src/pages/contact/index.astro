---
import Layout from "@/layouts/Layout.astro";
import { getEntry } from "astro:content";
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import {
  getSiteSettings,
  whatsappLink,
  mailtoLink,
  isConfiguredContactValue,
  PROPERTY_APPLICATION_EMAIL_BODY,
  PROPERTY_APPLICATION_EMAIL_SUBJECT,
  BUSINESS_ACCOMMODATION_EMAIL_BODY,
  BUSINESS_ACCOMMODATION_EMAIL_SUBJECT,
} from "@/lib/content";
import { SectionHeader } from "@/components/custom/section-header";
import { CtaLink } from "@/components/custom/cta-link";
import { IconMark } from "@/components/custom/icon-mark";
import { TextLink } from "@/components/custom/text-link";
import { BedDouble, Building2, CircleHelp, House } from "lucide-react";

// Each route's icon identifies the enquiry type, matched on its CMS title.
const routeIcon = (title: string) =>
  /list|property/i.test(title)
    ? House
    : /company|team/i.test(title)
      ? Building2
      : /accommodation/i.test(title)
        ? BedDouble
        : CircleHelp;

/* Contact — a welcoming, full-page entrance that leads into four clear
   enquiry routes, with WhatsApp first and ACOSA on LinkedIn. */

export const prerender = true;

const page = await getEntry("contactPage", "contact");
if (!page) throw new Error("Contact page content not found");
const settings = await getSiteSettings();
const uiCopy = settings.data.uiCopy.contact;
const { hero, contactRoutes } = page.data;
const seo = page.data.seo;
const helpHeadingIndex = hero.heading.toLowerCase().lastIndexOf("help");

// Cast: seoFields() in content.config.ts types image() as ZodTypeAny, which
// erases ImageMetadata from the inferred schema. The runtime value is one.
const ogImageUrl = seo?.ogImage
  ? (
      await getImage({
        src: seo.ogImage as ImageMetadata,
        width: 1200,
        height: 630,
      })
    ).src
  : undefined;

const email = settings.data.enquiryEmail;
const configuredEmail = isConfiguredContactValue(email) ? email : "";
const configuredWhatsapp = isConfiguredContactValue(
  settings.data.defaultWhatsapp,
)
  ? settings.data.defaultWhatsapp
  : "";
const routeHref = (
  link: string,
  subject?: string,
  message?: string,
  applicationRequest = false,
  requirementsRequest = false,
) =>
  link === "email"
    ? configuredEmail
      ? mailtoLink(
          configuredEmail,
          applicationRequest
            ? PROPERTY_APPLICATION_EMAIL_SUBJECT
            : requirementsRequest
              ? BUSINESS_ACCOMMODATION_EMAIL_SUBJECT
              : subject || "General ACOSA Enquiry",
          applicationRequest
            ? PROPERTY_APPLICATION_EMAIL_BODY
            : requirementsRequest
              ? BUSINESS_ACCOMMODATION_EMAIL_BODY
              : undefined,
        )
      : "/contact"
    : link === "whatsapp"
      ? configuredWhatsapp
        ? whatsappLink(configuredWhatsapp, message)
        : "/contact"
      : link;

const bookingWhatsappHref = routeHref(
  "whatsapp",
  undefined,
  "Hi ACOSA, I'm looking for business accommodation and would appreciate assistance.",
);
const bookingRequirementsHref = routeHref(
  "email",
  BUSINESS_ACCOMMODATION_EMAIL_SUBJECT,
  undefined,
  false,
  true,
);
const propertyApplicationHref = routeHref(
  "email",
  PROPERTY_APPLICATION_EMAIL_SUBJECT,
  undefined,
  true,
);
const linkedin = settings.data.socialLinks.find((social) =>
  /linkedin/i.test(`${social.label} ${social.url}`),
);
---

<Layout
  title={seo?.title || "Contact ACOSA"}
  description={seo?.description ||
    "Get in touch with ACOSA about business accommodation in South Africa."}
  ogImage={ogImageUrl}
>
  <section class="surface-navy relative isolate overflow-hidden">
    {
      hero.image && (
        <Image
          src={hero.image}
          format="webp"
          quality={75}
          alt=""
          widths={[480, 768, 1200, 1600, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 z-0 h-full w-full object-cover object-[68%_center] brightness-110 saturate-110 md:object-[72%_center]"
        />
      )
    }
    <div
      aria-hidden="true"
      class="from-navy/55 via-navy/38 to-navy/60 md:from-navy/78 md:via-navy/38 md:to-navy/16 absolute inset-0 z-10 bg-linear-to-b md:bg-linear-to-r"
    >
    </div>

    <div
      class="container-page relative z-20 flex min-h-[calc(100svh-5rem)] flex-col justify-center gap-10 py-12 sm:gap-12 sm:py-16 lg:gap-14 lg:py-20"
    >
      <header class="flex max-w-3xl flex-col gap-5">
        {hero.eyebrow && <p class="eyebrow-accent">{hero.eyebrow}</p>}
        <h1 class="type-h1 text-white">
          {
            helpHeadingIndex >= 0 ? (
              <>
                {hero.heading.slice(0, helpHeadingIndex)}
                <span class="accent-underline">
                  {hero.heading.slice(helpHeadingIndex, helpHeadingIndex + 4)}
                </span>
                {hero.heading.slice(helpHeadingIndex + 4)}
              </>
            ) : (
              hero.heading
            )
          }
        </h1>
        <p class="type-lead text-white/85">{hero.body}</p>
      </header>

      <div id="contact-options" class="flex flex-col gap-6 sm:gap-8">
        <SectionHeader
          eyebrow={uiCopy.routesEyebrow}
          title={uiCopy.routesHeading}
          titleClassName="text-white"
          accent
        />

        <ol class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5">
          {
            contactRoutes.map((route) => {
              return (
                <li
                  data-reveal
                  style={`--reveal-index: ${Number(route.number) - 1}; --foreground: #050a3c; --card: #ffffff; --card-foreground: #050a3c; --border: #d6ccbf; --muted-foreground: #695f54;`}
                  class="bg-card/95 border-border hover:border-foreground/30 flex min-w-0 flex-col gap-6 rounded-xl border p-5 shadow-[0_18px_40px_-28px_rgb(5_10_60/0.4)] backdrop-blur-md transition-[border-color,box-shadow,translate] duration-200 hover:-translate-y-0.5 sm:p-6 md:p-8"
                >
                  <div class="flex flex-col gap-2">
                    <IconMark icon={routeIcon(route.title)} className="mb-2" />
                    <h2 class="type-h3">{route.title}</h2>
                    <p class="type-body">{route.description}</p>
                    <ul class="mt-2 flex flex-col gap-2">
                      {route.details.map((detail) => (
                        <li class="text-foreground/80 flex items-start gap-2 text-sm leading-relaxed">
                          <span
                            aria-hidden="true"
                            class="bg-gold mt-2 size-1.5 shrink-0 rounded-full"
                          />
                          <span>{detail}</span>
                        </li>
                      ))}
                    </ul>
                    {route.note && <p class="type-small mt-2">{route.note}</p>}
                    {route.learnMoreLabel && route.learnMoreLink && (
                      <TextLink
                        label={route.learnMoreLabel}
                        href={route.learnMoreLink}
                        className="mt-2"
                      />
                    )}
                  </div>
                </li>
              );
            })
          }
        </ol>
        <div class="flex flex-col gap-5 border-t border-white/30 pt-6">
          <div class="flex flex-col gap-2">
            <h2 class="type-h2 text-white">{uiCopy.readyHeading}</h2>
            <p class="type-emphasis text-white">{uiCopy.readyBody}</p>
          </div>
          <div
            class="flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center sm:gap-6"
          >
            <CtaLink
              label={uiCopy.bookingCta}
              href={bookingRequirementsHref}
              variant="primary"
              icon="email"
              trackingKey="contact_booking_requirements_click"
            />
            <CtaLink
              label={uiCopy.applicationCta}
              href={propertyApplicationHref}
              variant="secondary"
              icon="email"
              trackingKey="contact_property_application_click"
              className="text-navy w-full border-white bg-white hover:border-white hover:bg-white/90 sm:w-auto"
            />
            <CtaLink
              label={uiCopy.whatsappCta}
              href={bookingWhatsappHref}
              variant="link"
              icon="whatsapp"
              external={bookingWhatsappHref.startsWith("https://wa.me/")}
              trackingKey="contact_whatsapp_click"
              className="!text-white"
            />
          </div>
        </div>
      </div>

      {
        linkedin && (
          <div class="flex flex-col gap-4 border-t border-white/30 pt-6 sm:flex-row sm:items-center sm:justify-between">
            <h2 class="type-h3 text-white">{uiCopy.followHeading}</h2>
            <CtaLink
              label={uiCopy.linkedinCta}
              href={linkedin.url}
              variant="secondary"
              icon="external"
              external
              trackingKey="contact_linkedin_click"
              className="w-full border-white bg-white text-navy hover:border-white hover:bg-white/90 sm:w-auto"
            />
          </div>
        )
      }
    </div>
  </section>
</Layout>
