---
import { getEntry } from "astro:content";
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "@/layouts/Layout.astro";
import { Section } from "@/components/custom/section";
import { Hero } from "@/components/custom/hero";
import { resolveCtaLink } from "@/lib/content";
import { CtaLink } from "@/components/custom/cta-link";
import { FeatureList } from "@/components/custom/feature-list";
import { SectionIcon } from "@/components/custom/section-icon";
import { Award, ClipboardCheck, Sparkles } from "lucide-react";

export const prerender = true;

const page = await getEntry("whyAcosaPage", "why-acosa");
if (!page) throw new Error("Why ACOSA page content not found");
const {
  hero,
  experienceSection,
  curationSection,
  approvedSection,
  outcomeSection,
} = page.data;
const seo = page.data.seo;

// Cast: seoFields() in content.config.ts types image() as ZodTypeAny, which
// erases ImageMetadata from the inferred schema. The runtime value is one.
const ogImageUrl = seo?.ogImage
  ? (
      await getImage({
        src: seo.ogImage as ImageMetadata,
        width: 1200,
        height: 630,
      })
    ).src
  : undefined;

const heroHref = resolveCtaLink(hero.cta.link, { email: "" });
---

<Layout
  title={seo?.title || "Why ACOSA"}
  description={seo?.description ||
    "How ACOSA vets every property, and what ACOSA Approved means for business travellers."}
  ogImage={ogImageUrl}
>
  <Hero
    eyebrow={hero.eyebrow}
    heading={hero.heading}
    body={hero.body}
    image={hero.image}
    imageAlt="ACOSA hospitality assessment"
    imageClassName="scale-105 object-[42%_center] md:scale-105 md:object-[46%_center] lg:object-center"
    primaryCta={{ label: hero.cta.label, href: heroHref }}
  />

  <Section className="mt-16">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <div>
        <div class="flex items-center gap-3">
          <SectionIcon icon={Award} />
          <p class="text-muted-foreground text-xs font-semibold tracking-wider uppercase">
            {experienceSection.eyebrow}
          </p>
        </div>
        <h2 class="text-primary mt-2 text-2xl font-bold md:text-3xl">
          {experienceSection.heading}
        </h2>
        <p class="text-muted-foreground mt-4 whitespace-pre-line">
          {experienceSection.body}
        </p>
      </div>
      <div class="bg-muted/30 flex items-center justify-center rounded-2xl p-8">
        <p class="text-muted-foreground text-center text-sm italic">
          "Two decades of hands-on hospitality experience across guesthouses, lodges, and corporate accommodation."
        </p>
      </div>
    </div>
  </Section>

  <Section className="mt-16">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      {
        curationSection.image && (
          <Image
            src={curationSection.image}
            alt="ACOSA reviewing an independent accommodation property"
            class="aspect-4/3 w-full rounded-2xl object-cover"
          />
        )
      }
      <div>
        <div class="flex items-center gap-3">
          <SectionIcon icon={ClipboardCheck} />
          <p class="text-muted-foreground text-xs font-semibold tracking-wider uppercase">
            {curationSection.eyebrow}
          </p>
        </div>
        <h2 class="text-primary mt-2 text-2xl font-bold md:text-3xl">
          {curationSection.heading}
        </h2>
        <p class="text-muted-foreground mt-3">{curationSection.body}</p>
        <FeatureList
          className="mt-6"
          items={curationSection.factorsInclude.map((factor) => ({ text: factor }))}
        />
        {
          curationSection.highlightStatement && (
            <p class="text-primary mt-6 text-lg font-semibold">
              {curationSection.highlightStatement}
            </p>
          )
        }
        {
          curationSection.note && (
            <p class="text-muted-foreground mt-3 text-sm">
              {curationSection.note}
            </p>
          )
        }
      </div>
    </div>
  </Section>

  <Section className="mt-16">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-primary text-2xl font-bold md:text-3xl">
        {approvedSection.heading}
      </h2>
      <p class="text-muted-foreground mt-4 whitespace-pre-line">
        {approvedSection.body}
      </p>
      <CtaLink
        label={approvedSection.cta.label}
        href={approvedSection.cta.link}
        variant="secondary"
        size="md"
        icon="arrow"
        className="mt-6"
      />
    </div>
  </Section>

  <Section className="mt-16 mb-28">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <div>
        <div class="flex items-center gap-3">
          <SectionIcon icon={Sparkles} />
          <h2 class="text-primary text-2xl font-bold md:text-3xl">
            {outcomeSection.heading}
          </h2>
        </div>
        <p class="text-muted-foreground mt-4">{outcomeSection.body}</p>
        <CtaLink
          label={outcomeSection.cta.label}
          href={outcomeSection.cta.link}
          variant="secondary"
          size="md"
          icon="arrow"
          className="mt-6"
        />
      </div>
      {
        outcomeSection.image && (
          <Image
            src={outcomeSection.image}
            alt="A comfortable end to a business travel day"
            class="aspect-4/3 w-full rounded-2xl object-cover"
          />
        )
      }
    </div>
  </Section>
</Layout>
