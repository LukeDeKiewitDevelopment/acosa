---
import { getEntry } from "astro:content";
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "@/layouts/Layout.astro";
import { Section } from "@/components/custom/section";
import { SectionHeader } from "@/components/custom/section-header";
import ClosingImageSection from "@/components/custom/closing-image-section.astro";
import { Hero } from "@/components/custom/hero";
import { resolveCtaLink } from "@/lib/content";
import { CtaLink } from "@/components/custom/cta-link";
import { SectionNav } from "@/components/custom/section-nav";
import {
  BadgeCheck,
  BedDouble,
  Briefcase,
  Car,
  Check,
  ConciergeBell,
  Coffee,
  Laptop,
  ShieldCheck,
  Sparkles,
  Wifi,
  Zap,
} from "lucide-react";

export const prerender = true;

/* Why ACOSA? — Creative Direction Blueprint, Page 05.
   The most editorial trust page: the experience claim, the selection
   criteria and the ACOSA Approved explanation each carry distinct visual
   weight. The criteria use a restrained icon list, not a wall of equal cards.
   Explore ACOSA Properties follows the trust-building content. */

const page = await getEntry("whyAcosaPage", "why-acosa");
if (!page) throw new Error("Why ACOSA page content not found");
const {
  hero,
  experienceSection,
  curationSection,
  approvedSection,
  outcomeSection,
} = page.data;
const seo = page.data.seo;

// Cast: seoFields() in content.config.ts types image() as ZodTypeAny, which
// erases ImageMetadata from the inferred schema. The runtime value is one.
const ogImageUrl = seo?.ogImage
  ? (
      await getImage({
        src: seo.ogImage as ImageMetadata,
        width: 1200,
        height: 630,
      })
    ).src
  : undefined;

const heroHref = resolveCtaLink(hero.cta.link, { email: "" });

// One icon family; criteria map to an icon by keyword, falling back to a check.
const criterionIcons: [RegExp, typeof Check][] = [
  [/wifi/i, Wifi],
  [/workspace/i, Laptop],
  [/parking/i, Car],
  [/power/i, Zap],
  [/clean/i, Sparkles],
  [/breakfast/i, Coffee],
  [/comfort/i, BedDouble],
  [/service/i, ConciergeBell],
  [/security/i, ShieldCheck],
  [/usability/i, Briefcase],
];
const iconFor = (criterion: string) =>
  criterionIcons.find(([pattern]) => pattern.test(criterion))?.[1] ?? Check;

// "More than 20 years of …" → "20+" for the experience figure.
const yearsMatch = experienceSection.heading.match(/(\d+)\s+years/i);
const yearsFigure = yearsMatch ? `${yearsMatch[1]}+` : null;
const experienceHeadingTrimmed = experienceSection.heading.trim();
const experienceHeadingLastSpace = experienceHeadingTrimmed.lastIndexOf(" ");
const curationLeadMatch = curationSection.body.match(/^[\s\S]*?[.!?](?=\s|$)/);
const curationEmphasis = curationLeadMatch?.[0] ?? curationSection.body;
const curationSupportingCopy = curationSection.body
  .slice(curationEmphasis.length)
  .trim();
const approvedLeadMatch = approvedSection.body.match(/^[\s\S]*?[.!?](?=\s|$)/);
const approvedEmphasis = approvedLeadMatch?.[0] ?? approvedSection.body;
const approvedSupportingCopy = approvedSection.body
  .slice(approvedEmphasis.length)
  .split(/\n+/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
const [experienceLead, ...experienceBody] = experienceSection.body
  .split(/\n+/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

<Layout
  title={seo?.title || "Why ACOSA"}
  description={seo?.description ||
    "How ACOSA vets every property, and what ACOSA Approved means for business travellers."}
  ogImage={ogImageUrl}
>
  <Hero
    emphasizeBody
    align="right"
    eyebrow={hero.eyebrow}
    heading={hero.heading}
    body={hero.body}
    image={hero.image}
    imageAlt="A guest preparing breakfast in a welcoming guesthouse"
    imageClassName="object-[44%_center] sm:object-[42%_center] lg:object-[40%_center]"
    primaryCta={{ label: hero.cta.label, href: heroHref }}
  />

  <SectionNav
    client:load
    items={[
      { id: "experience", label: "Our experience" },
      { id: "curation", label: "How we curate" },
      { id: "acosa-approved", label: "ACOSA Approved" },
      ...(outcomeSection.image
        ? [{ id: "outcome", label: "Explore ACOSA" }]
        : []),
    ]}
  />

  {/* Experience claim: a figure, then editorial prose. */}
  <Section id="experience">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
      <div
        data-reveal
        class="surface-navy relative isolate flex min-h-[22rem] flex-col gap-6 overflow-hidden rounded-xl p-7 md:min-h-[28rem] md:p-10"
      >
        {
          experienceSection.image && (
            <Image
              src={experienceSection.image}
              format="webp"
              quality={75}
              loading="lazy"
              alt="A hospitality professional standing in a sunlit garden"
              widths={[480, 800, 1200, 1408]}
              sizes="(min-width: 1024px) 45vw, 100vw"
              class="absolute inset-0 -z-20 h-full w-full object-cover object-[72%_center]"
            />
          )
        }
        <div
          aria-hidden="true"
          class="bg-navy/10 from-navy/70 via-navy/45 to-navy/20 absolute inset-0 -z-10 bg-linear-to-t"
        >
        </div>
        <p class="eyebrow relative z-10 text-white">
          {experienceSection.eyebrow}
        </p>
        {
          yearsFigure && (
            <p class="font-heading text-gold relative z-10 text-[5.5rem] leading-none font-semibold tracking-[-0.04em] md:text-[7.5rem]">
              {yearsFigure}
              <span class="mt-3 block max-w-full font-sans text-base leading-snug font-semibold tracking-normal text-white drop-shadow-sm md:text-xl">
                years of hands-on hospitality experience
              </span>
            </p>
          )
        }
      </div>
      <div class="flex flex-col gap-6">
        <h2 class="type-h2">
          {experienceHeadingTrimmed.slice(0, experienceHeadingLastSpace + 1)}
          <span class="accent-underline">
            {experienceHeadingTrimmed.slice(experienceHeadingLastSpace + 1)}
          </span>
        </h2>
        {experienceLead && <p class="type-emphasis">{experienceLead}</p>}
        {
          experienceBody.map((paragraph) => (
            <p class="type-body">{paragraph}</p>
          ))
        }
      </div>
    </div>
  </Section>

  {/* Selection criteria */}
  <Section id="curation" tone="warm">
    <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-20">
      <div class="flex flex-col gap-8 lg:sticky lg:top-28">
        {
          curationSection.image && (
            <Image
              src={curationSection.image}
              format="webp"
              quality={75}
              loading="lazy"
              alt="A couple reviewing accommodation information together"
              widths={[480, 800, 1200, 1408]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              class="aspect-4/3 w-full rounded-xl object-cover object-[60%_center]"
            />
          )
        }
        {
          curationSection.highlightStatement && (
            <div class="grid grid-cols-[3.5rem_1fr] items-center gap-4">
              <span
                aria-hidden="true"
                class="border-gold/40 text-gold flex size-14 items-center justify-center rounded-xl border"
              >
                <BadgeCheck className="size-7" />
              </span>
              <p class="font-heading text-navy border-gold border-l-2 pl-5 text-[1.875rem] leading-snug font-semibold md:text-[2rem]">
                {curationSection.highlightStatement}
              </p>
            </div>
          )
        }
      </div>
      <div class="flex flex-col gap-8">
        <SectionHeader
          eyebrow={curationSection.eyebrow}
          title={curationSection.heading}
          underline
        >
          <p class="type-emphasis">{curationEmphasis}</p>
          {
            curationSupportingCopy && (
              <p class="type-body">{curationSupportingCopy}</p>
            )
          }
        </SectionHeader>
        <ul
          class="border-sage divide-sage grid border-t sm:grid-cols-2 sm:gap-x-8"
        >
          {
            curationSection.factorsInclude.map((factor) => {
              const Icon = iconFor(factor);
              return (
                <li class="border-sage flex items-center gap-3.5 border-b py-4">
                  <Icon
                    className="text-gold-ink size-5 shrink-0"
                    aria-hidden="true"
                  />
                  <span class="text-foreground text-[0.9375rem] first-letter:uppercase">
                    {factor}
                  </span>
                </li>
              );
            })
          }
        </ul>
        {
          curationSection.note && (
            <p class="type-body">{curationSection.note}</p>
          )
        }
      </div>
    </div>
  </Section>

  {/* ACOSA Approved: editorial copy beside the supporting property image. */}
  <Section spacing="none" fullWidth id="acosa-approved">
    <div class="surface-ivory grid lg:min-h-160 lg:grid-cols-2">
      <div class="flex items-center">
        <div
          class="flex w-full max-w-xl flex-col gap-5 px-4 py-14 sm:px-6 md:py-20 lg:px-16 xl:px-20"
        >
          <span
            aria-hidden="true"
            class="border-gold/40 text-gold flex size-20 items-center justify-center rounded-xl border"
          >
            <BadgeCheck className="size-14" />
          </span>
          <h2 class="type-h2">{approvedSection.heading}</h2>
          <p class="type-emphasis">{approvedEmphasis}</p>
          {
            approvedSupportingCopy.map((paragraph) => (
              <p class="type-body">{paragraph}</p>
            ))
          }
          <CtaLink
            label={approvedSection.cta.label}
            href={approvedSection.cta.link}
            variant="primary"
            size="lg"
            icon="arrow"
            className="mt-3"
            trackingKey="why_explore_properties_click"
          />
        </div>
      </div>
      {
        approvedSection.image && (
          <div class="relative aspect-4/3 sm:aspect-video lg:aspect-auto">
            <Image
              src={approvedSection.image}
              format="webp"
              quality={75}
              loading="lazy"
              alt="A peaceful garden courtyard at a curated guesthouse"
              widths={[480, 800, 1200, 1408]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              class="absolute inset-0 h-full w-full object-cover object-[60%_center]"
            />
          </div>
        )
      }
    </div>
  </Section>

  {/* Outcome */}
  {
    outcomeSection.image && (
      <ClosingImageSection
        id="outcome"
        heading={outcomeSection.heading}
        body={outcomeSection.body}
        image={outcomeSection.image}
        imagePosition="top"
        desktopAspectRatio="video"
        imageAlt="A traveller relaxing at her guesthouse at the end of a work day"
        actions={[
          {
            label: outcomeSection.cta.label,
            href: outcomeSection.cta.link,
            variant: "secondary",
            icon: "arrow",
          },
        ]}
      />
    )
  }
</Layout>
