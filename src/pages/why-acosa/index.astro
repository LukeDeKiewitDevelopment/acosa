---
import { getEntry } from "astro:content";
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "@/layouts/Layout.astro";
import { Section } from "@/components/custom/section";
import { SectionHeader } from "@/components/custom/section-header";
import { Hero } from "@/components/custom/hero";
import { NODE_MAP_COORDINATES, resolveCtaLink } from "@/lib/content";
import { SaMap } from "@/components/custom/map-graphics";
import { CtaLink } from "@/components/custom/cta-link";
import {
  BadgeCheck,
  BedDouble,
  Briefcase,
  Car,
  Check,
  ConciergeBell,
  Coffee,
  Laptop,
  ShieldCheck,
  Sparkles,
  Wifi,
  Zap,
} from "lucide-react";

export const prerender = true;

/* Why ACOSA? — Creative Direction Blueprint, Page 05.
   The most editorial trust page: the experience claim, the selection
   criteria and the ACOSA Approved explanation each carry distinct visual
   weight. The criteria use a restrained icon list, not a wall of equal cards.
   Explore ACOSA Properties follows the trust-building content. */

const page = await getEntry("whyAcosaPage", "why-acosa");
if (!page) throw new Error("Why ACOSA page content not found");
const {
  hero,
  experienceSection,
  curationSection,
  approvedSection,
  outcomeSection,
} = page.data;
const seo = page.data.seo;

// Cast: seoFields() in content.config.ts types image() as ZodTypeAny, which
// erases ImageMetadata from the inferred schema. The runtime value is one.
const ogImageUrl = seo?.ogImage
  ? (
      await getImage({
        src: seo.ogImage as ImageMetadata,
        width: 1200,
        height: 630,
      })
    ).src
  : undefined;

const heroHref = resolveCtaLink(hero.cta.link, { email: "" });

// One icon family; criteria map to an icon by keyword, falling back to a check.
const criterionIcons: [RegExp, typeof Check][] = [
  [/wifi/i, Wifi],
  [/workspace/i, Laptop],
  [/parking/i, Car],
  [/power/i, Zap],
  [/clean/i, Sparkles],
  [/breakfast/i, Coffee],
  [/comfort/i, BedDouble],
  [/service/i, ConciergeBell],
  [/security/i, ShieldCheck],
  [/usability/i, Briefcase],
];
const iconFor = (criterion: string) =>
  criterionIcons.find(([pattern]) => pattern.test(criterion))?.[1] ?? Check;

// "More than 20 years of …" → "20+" for the experience figure.
// ACOSA's business nodes, pinned on the experience section's map.
const nodePins = Object.values(NODE_MAP_COORDINATES).map(
  ([longitude, latitude]) => ({ longitude, latitude }),
);

const yearsMatch = experienceSection.heading.match(/(\d+)\s+years/i);
const yearsFigure = yearsMatch ? `${yearsMatch[1]}+` : null;
const [experienceLead, ...experienceBody] = experienceSection.body
  .split(/\n+/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

<Layout
  title={seo?.title || "Why ACOSA"}
  description={seo?.description ||
    "How ACOSA vets every property, and what ACOSA Approved means for business travellers."}
  ogImage={ogImageUrl}
>
  <Hero
    align="right"
    eyebrow={hero.eyebrow}
    heading={hero.heading}
    body={hero.body}
    image={hero.image}
    imageAlt="A business traveller checking in at an independent guesthouse"
    imageClassName="object-[32%_center] sm:object-[30%_center] lg:object-[24%_center]"
    primaryCta={{ label: hero.cta.label, href: heroHref }}
  />

  {/* Experience claim: a figure, then editorial prose. */}
  <Section>
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
      <div
        data-reveal
        class="surface-warm relative isolate flex min-h-[22rem] flex-col gap-6 overflow-hidden rounded-xl p-7 md:min-h-[28rem] md:p-10"
      >
        <SaMap
          pins={nodePins}
          className="text-navy absolute -right-[8%] -bottom-[6%] -z-10 w-[88%] opacity-70 md:w-[78%]"
        />
        <p class="eyebrow">{experienceSection.eyebrow}</p>
        {
          yearsFigure && (
            <p class="font-heading text-foreground text-[5.5rem] leading-none font-semibold tracking-[-0.04em] md:text-[7.5rem]">
              {yearsFigure}
              <span class="text-muted-foreground mt-3 block font-sans text-sm font-medium tracking-normal">
                years of hands-on hospitality experience
              </span>
            </p>
          )
        }
      </div>
      <div class="flex flex-col gap-6">
        <h2 class="type-h2">{experienceSection.heading}</h2>
        {
          experienceLead && (
            <p class="type-lead text-foreground/85">{experienceLead}</p>
          )
        }
        {
          experienceBody.map((paragraph) => (
            <p class="type-body">{paragraph}</p>
          ))
        }
      </div>
    </div>
  </Section>

  {/* Selection criteria */}
  <Section tone="warm">
    <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-20">
      <div class="flex flex-col gap-8 lg:sticky lg:top-28">
        {
          curationSection.image && (
            <Image
              src={curationSection.image}
              alt="ACOSA assessing a guesthouse room with the owner"
              widths={[480, 800, 1200, 1408]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              class="aspect-4/3 w-full rounded-xl object-cover object-[60%_center]"
            />
          )
        }
        {
          curationSection.highlightStatement && (
            <p class="font-heading text-foreground border-gold border-l-2 pl-5 text-2xl leading-snug font-semibold md:text-[1.75rem]">
              {curationSection.highlightStatement}
            </p>
          )
        }
      </div>
      <div class="flex flex-col gap-8">
        <SectionHeader
          eyebrow={curationSection.eyebrow}
          title={curationSection.heading}
          lead={curationSection.body}
        />
        <ul
          class="border-sage divide-sage grid border-t sm:grid-cols-2 sm:gap-x-8"
        >
          {
            curationSection.factorsInclude.map((factor) => {
              const Icon = iconFor(factor);
              return (
                <li class="border-sage flex items-center gap-3.5 border-b py-4">
                  <Icon
                    className="text-gold-ink size-5 shrink-0"
                    aria-hidden="true"
                  />
                  <span class="text-foreground text-[0.9375rem] first-letter:uppercase">
                    {factor}
                  </span>
                </li>
              );
            })
          }
        </ul>
        {
          curationSection.note && (
            <p class="type-small text-xs">{curationSection.note}</p>
          )
        }
      </div>
    </div>
  </Section>

  {/* ACOSA Approved: the explanation gets its own authority band. */}
  <Section id="acosa-approved" tone="navy">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-6 text-center">
      <span
        class="border-gold/50 flex size-16 items-center justify-center rounded-xl border"
      >
        <BadgeCheck className="text-gold size-8" aria-hidden="true" />
      </span>
      <h2 class="type-h2">{approvedSection.heading}</h2>
      {
        approvedSection.body
          .split(/\n+/)
          .map((paragraph) => paragraph.trim())
          .filter(Boolean)
          .map((paragraph, index) => (
            <p class={index === 0 ? "type-lead" : "type-small"}>{paragraph}</p>
          ))
      }
      <CtaLink
        label={approvedSection.cta.label}
        href={approvedSection.cta.link}
        variant="primary"
        size="lg"
        icon="arrow"
        className="mt-3"
        trackingKey="why_explore_properties_click"
      />
    </div>
  </Section>

  {/* Outcome */}
  <Section>
    <div
      class="grid items-center gap-10 md:grid-cols-2 lg:grid-cols-[1fr_1.15fr] lg:gap-20"
    >
      <SectionHeader title={outcomeSection.heading} lead={outcomeSection.body}>
        <CtaLink
          label={outcomeSection.cta.label}
          href={outcomeSection.cta.link}
          variant="secondary"
          icon="arrow"
          className="mt-3 w-fit"
        />
      </SectionHeader>
      {
        outcomeSection.image && (
          <Image
            src={outcomeSection.image}
            alt="A traveller relaxing at her guesthouse at the end of a work day"
            widths={[480, 800, 1200, 1408]}
            sizes="(min-width: 768px) 55vw, 100vw"
            class="aspect-4/3 w-full rounded-xl object-cover object-[72%_center]"
          />
        )
      }
    </div>
  </Section>
</Layout>
