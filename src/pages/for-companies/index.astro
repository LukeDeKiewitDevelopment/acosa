---
import { getEntry } from "astro:content";
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "@/layouts/Layout.astro";
import { Section } from "@/components/custom/section";
import { Hero } from "@/components/custom/hero";
import { getSiteSettings, mailtoLink, whatsappLink } from "@/lib/content";
import { ArrowRight, Check, MessageCircle } from "lucide-react";

export const prerender = true;

const page = await getEntry("forCompaniesPage", "for-companies");
if (!page) throw new Error("For Companies page content not found");
const settings = await getSiteSettings();
const {
  hero,
  whoWeHelpSection,
  howAcosaHelpsSection,
  teamsAndProjectsSection,
  assistanceSection,
  finalCta,
} = page.data;
const seo = page.data.seo;

// Cast: seoFields() in content.config.ts types image() as ZodTypeAny, which
// erases ImageMetadata from the inferred schema. The runtime value is one.
const ogImageUrl = seo?.ogImage
  ? (
      await getImage({
        src: seo.ogImage as ImageMetadata,
        width: 1200,
        height: 630,
      })
    ).src
  : undefined;

const email = settings.data.enquiryEmail;
const emailLink = mailtoLink(email, "Corporate Accommodation Requirements");
const teamEmailLink = mailtoLink(
  email,
  "Team or Project Accommodation Request",
);
const generalEmailLink = mailtoLink(email, "Corporate Accommodation Enquiry");
const whatsapp = whatsappLink(
  settings.data.defaultWhatsapp,
  "Hi ACOSA, I need assistance finding accommodation for a team or project.",
);
---

<Layout
  title={seo?.title || "For Companies | Acosa"}
  description={seo?.description ||
    "Corporate accommodation solutions for teams travelling across South Africa."}
  ogImage={ogImageUrl}
>
  <Hero
    eyebrow={hero.eyebrow}
    heading={hero.heading}
    body={hero.body}
    image={hero.image}
    imageAlt="A corporate booker arranging business accommodation"
    primaryCta={{ label: hero.primaryCta.label, href: "/business-nodes" }}
    secondaryCta={{ label: hero.secondaryCta.label, href: emailLink }}
  />

  <Section className="mt-16">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-primary text-2xl font-bold md:text-3xl">
        {whoWeHelpSection.heading}
      </h2>
      <p class="text-muted-foreground mt-3">{whoWeHelpSection.body}</p>
      <ul class="mt-8 grid grid-cols-1 gap-3 text-left sm:grid-cols-2">
        {
          whoWeHelpSection.roles.map((role) => (
            <li class="bg-card flex items-center gap-3 rounded-lg border p-4 text-sm">
              <Check class="text-secondary size-4" aria-hidden="true" />
              {role}
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section className="mt-16">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-primary text-2xl font-bold md:text-3xl">
        {howAcosaHelpsSection.heading}
      </h2>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {
          howAcosaHelpsSection.features.map((feature) => (
            <article class="bg-card rounded-lg border p-5">
              <>
                <h3 class="text-primary font-semibold">{feature.title}</h3>
                <p class="text-muted-foreground mt-2 text-sm">{feature.body}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </Section>

  <Section className="mt-16">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      {
        teamsAndProjectsSection.image && (
          <Image
            src={teamsAndProjectsSection.image}
            alt="A project team staying in business accommodation"
            class="aspect-[4/3] w-full rounded-2xl object-cover"
          />
        )
      }
      <div>
        <h2 class="text-primary text-2xl font-bold md:text-3xl">
          {teamsAndProjectsSection.heading}
        </h2>
        <p class="text-muted-foreground mt-3">{teamsAndProjectsSection.body}</p>
        <ul class="mt-5 space-y-2 text-sm">
          {
            teamsAndProjectsSection.requirementsList.map((item) => (
              <li class="flex items-center gap-3">
                <Check class="text-secondary size-4" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href={teamEmailLink}
            class="bg-secondary text-secondary-foreground inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium no-underline"
            >{teamsAndProjectsSection.primaryCta.label}<ArrowRight
              className="size-4"
              aria-hidden="true"
            /></a
          >
          <a
            href={whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="border-secondary text-secondary inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-medium no-underline"
            ><MessageCircle className="size-4" aria-hidden="true" />{
              teamsAndProjectsSection.secondaryCta.label
            }</a
          >
        </div>
      </div>
    </div>
  </Section>

  <Section className="mt-16">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-primary text-2xl font-bold md:text-3xl">
        {assistanceSection.heading}
      </h2><p class="text-muted-foreground mt-3">{assistanceSection.body}</p><a
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-secondary text-secondary-foreground mt-6 inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium no-underline"
        ><MessageCircle className="size-4" aria-hidden="true" />{
          assistanceSection.cta.label
        }</a>
    </div>
  </Section>

  <Section className="mt-16 mb-28">
    <div
      class="bg-primary text-primary-foreground mx-auto max-w-4xl rounded-2xl p-8 text-center md:p-12"
    >
      <h2 class="text-2xl font-bold md:text-3xl">{finalCta.heading}</h2><p
        class="mt-3 opacity-90"
      >
        {finalCta.body}
      </p><a
        href={generalEmailLink}
        class="bg-background text-foreground mt-6 inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium no-underline"
        >{finalCta.cta.label}<ArrowRight
          className="size-4"
          aria-hidden="true"
        /></a>
    </div>
  </Section>
</Layout>
