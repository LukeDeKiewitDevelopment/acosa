---
import { getEntry } from "astro:content";
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "@/layouts/Layout.astro";
import { Section } from "@/components/custom/section";
import { SectionHeader } from "@/components/custom/section-header";
import { Hero } from "@/components/custom/hero";
import { getSiteSettings, resolveCtaLink } from "@/lib/content";
import { CtaLink } from "@/components/custom/cta-link";
import ClosingImageSection from "@/components/custom/closing-image-section.astro";
import { IconMark } from "@/components/custom/icon-mark";
import { SectionNav } from "@/components/custom/section-nav";
import shortlistBackground from "@/assets/images/pages/for-companies/shortlist-background.png";
import whoWeHelpBackground from "@/assets/images/pages/for-companies/who-we-help-2-13.png";
import {
  BadgeCheck,
  BriefcaseBusiness,
  Building2,
  CalendarDays,
  Check,
  ClipboardList,
  ConciergeBell,
  FolderKanban,
  Hourglass,
  ListChecks,
  MapPin,
  Plane,
  Settings2,
  UserRound,
  Users,
} from "lucide-react";

export const prerender = true;

/* For Companies — Creative Direction Blueprint, Page 06, and addendum §12.
   A structured B2B rhythm: who we help → self-service discovery vs assisted
   enquiry (immediately distinguishable) → Teams & Project Stays → one clean,
   decisive contact panel with a full-width closing image. */

const page = await getEntry("forCompaniesPage", "for-companies");
if (!page) throw new Error("For Companies page content not found");
const settings = await getSiteSettings();
const {
  hero,
  whoWeHelpSection,
  howAcosaHelpsSection,
  teamsAndProjectsSection,
  finalCta,
} = page.data;
const seo = page.data.seo;

// Cast: seoFields() in content.config.ts types image() as ZodTypeAny, which
// erases ImageMetadata from the inferred schema. The runtime value is one.
const ogImageUrl = seo?.ogImage
  ? (
      await getImage({
        src: seo.ogImage as ImageMetadata,
        width: 1200,
        height: 630,
      })
    ).src
  : undefined;

const email = settings.data.enquiryEmail;
const whatsappNumber = settings.data.defaultWhatsapp;
const heroPrimaryHref = resolveCtaLink(hero.primaryCta.link, {
  email,
  emailSubject: "Corporate Accommodation Requirements",
  whatsappNumber,
});
const heroSecondaryHref = resolveCtaLink(hero.secondaryCta.link, {
  email,
  emailSubject: "Corporate Accommodation Requirements",
  whatsappNumber,
});
const teamPrimaryHref = resolveCtaLink(
  teamsAndProjectsSection.primaryCta.link,
  {
    email,
    emailSubject: "Team or Project Accommodation Request",
    whatsappNumber,
  },
);
const teamSecondaryHref = resolveCtaLink(
  teamsAndProjectsSection.secondaryCta.link,
  {
    email,
    emailSubject: "Team or Project Accommodation Request",
    whatsappNumber,
    whatsappMessage:
      "Hi ACOSA, I need assistance finding accommodation for a team or project.",
  },
);
const finalPrimaryHref = resolveCtaLink(finalCta.primaryCta.link, {
  email,
  emailSubject: "Corporate Accommodation Enquiry",
  whatsappNumber,
});
const finalSecondaryHref = resolveCtaLink(finalCta.secondaryCta.link, {
  email,
  whatsappNumber,
  whatsappMessage:
    "Hi ACOSA, I'm arranging business accommodation and would appreciate some assistance.",
});

// The last feature ("Ask for Help When Necessary") is the assisted route;
// the rest are self-service discovery.
const selfService = howAcosaHelpsSection.features.slice(0, -1);
const assisted = howAcosaHelpsSection.features.at(-1);

// "Location: Where does the team need to be based?" → label + question.
// Icons matched on CMS wording (fallback: check).
const iconFor = (text: string, map: [RegExp, typeof Check][]) =>
  map.find(([pattern]) => pattern.test(text))?.[1] ?? Check;
const featureIcons: [RegExp, typeof Check][] = [
  [/location/i, MapPin],
  [/compare|information/i, ListChecks],
  [/curated/i, BadgeCheck],
  [/help/i, ConciergeBell],
];
const roleIcons: [RegExp, typeof Check][] = [
  [/executive assistant/i, UserRound],
  [/hr/i, Users],
  [/procurement/i, ClipboardList],
  [/operations/i, Settings2],
  [/project/i, FolderKanban],
  [/companies placing travelling employees/i, Plane],
  [/travel/i, BriefcaseBusiness],
  [/companies/i, Building2],
];
const requirementIcons: [RegExp, typeof Check][] = [
  [/^location/i, MapPin],
  [/travellers|people/i, Users],
  [/^dates/i, CalendarDays],
  [/length/i, Hourglass],
  [/requirement/i, ClipboardList],
];

const requirements = teamsAndProjectsSection.requirementsList.map((item) => {
  const [label, ...rest] = item.split(":");
  return rest.length > 0
    ? { label: label.trim(), detail: rest.join(":").trim() }
    : { label: "", detail: item };
});
---

<Layout
  title={seo?.title || "For Companies | ACOSA"}
  description={seo?.description ||
    "Corporate accommodation solutions for teams travelling across South Africa."}
  ogImage={ogImageUrl}
>
  <Hero
    emphasizeBody
    align="left"
    eyebrow={hero.eyebrow}
    heading={hero.heading}
    body={hero.body}
    image={hero.image}
    imageAlt="A corporate booker arranging business accommodation for a colleague"
    imageClassName="object-[76%_center] sm:object-[74%_center] lg:object-[70%_center]"
    primaryCta={{ label: hero.primaryCta.label, href: heroPrimaryHref }}
    secondaryCta={{ label: hero.secondaryCta.label, href: heroSecondaryHref }}
  />

  <SectionNav
    client:load
    items={[
      { id: "who-we-help", label: "Who we help" },
      { id: "discovery", label: "Find accommodation" },
      { id: "teams", label: "Teams & projects" },
      { id: "contact", label: "Get in touch" },
    ]}
  />

  {/* Who we help */}
  <Section id="who-we-help" spacing="tight">
    <div
      class="relative isolate grid overflow-hidden rounded-xl lg:aspect-[2.75/1]"
    >
      <Image
        src={whoWeHelpBackground}
        format="webp"
        quality={78}
        loading="lazy"
        alt="Two colleagues reviewing plans together at a laptop"
        widths={[768, 1200, 1600, 2000]}
        sizes="(min-width: 1280px) 1280px, 100vw"
        class="relative order-2 aspect-video w-full object-cover object-[72%_center] lg:absolute lg:inset-0 lg:order-0 lg:aspect-auto lg:h-full"
      />
      <div
        aria-hidden="true"
        class="from-background via-background/90 absolute inset-y-0 left-0 z-[1] hidden w-[56%] bg-gradient-to-r to-transparent lg:block"
      >
      </div>
      <div
        class="bg-background relative z-10 order-1 flex flex-col gap-5 px-6 py-7 sm:px-8 lg:h-full lg:w-[48%] lg:justify-center lg:bg-transparent lg:px-10 lg:py-8"
      >
        <SectionHeader
          title={whoWeHelpSection.heading}
          underline
          className="gap-3"
        >
          <p class="text-foreground text-sm font-semibold">
            {whoWeHelpSection.body}
          </p>
        </SectionHeader>
        <ul class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
          {
            whoWeHelpSection.roles.map((role) => (
              <li class="group border-sage hover:border-gold font-heading text-foreground flex items-center gap-2 border-t pt-3 text-sm font-semibold transition-[border-color,translate] duration-300 hover:-translate-y-1 motion-reduce:hover:translate-y-0">
                <IconMark
                  icon={iconFor(role, roleIcons)}
                  size="sm"
                  className="group-hover:bg-gold group-hover:text-navy transition-colors duration-300"
                />
                <span>{role}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  {/* Self-service discovery vs assisted enquiry */}
  <Section
    id="discovery"
    spacing="none"
    fullWidth
    className="isolate overflow-hidden"
  >
    <Image
      src={shortlistBackground}
      format="webp"
      quality={75}
      loading="lazy"
      alt=""
      widths={[768, 1200, 1600, 1920]}
      sizes="100vw"
      class="absolute inset-0 z-0 h-full w-full object-cover object-[center_55%]"
    />
    <div aria-hidden="true" class="bg-navy/70 absolute inset-0 z-10"></div>
    <div
      class="container-page relative z-20 flex flex-col gap-12 py-14 md:py-20"
    >
      <SectionHeader
        title={howAcosaHelpsSection.heading}
        underline
        titleClassName="text-white"
      />
      <div class="grid gap-5 lg:grid-cols-[1.6fr_1fr]">
        <div
          class="bg-card/95 border-border flex flex-col gap-8 rounded-xl border p-7 backdrop-blur-sm md:p-9"
        >
          <div class="flex items-center justify-between gap-4">
            <p class="eyebrow">Self-service discovery</p>
            <CtaLink
              label={hero.secondaryCta.label}
              href={heroSecondaryHref}
              variant="link"
              className="text-sm"
            />
          </div>
          <ol class="grid gap-8 md:grid-cols-3 md:gap-6">
            {
              selfService.map((feature) => (
                <li class="flex flex-col gap-3">
                  <IconMark
                    icon={iconFor(feature.title, featureIcons)}
                    size="sm"
                  />
                  <h3 class="type-h3">{feature.title}</h3>
                  <p class="type-small">{feature.body}</p>
                </li>
              ))
            }
          </ol>
        </div>
        {
          assisted && (
            <div class="surface-navy flex flex-col gap-5 rounded-xl p-7 md:p-9">
              <IconMark
                icon={iconFor(assisted.title, featureIcons)}
                tone="navy"
                size="sm"
              />
              <p class="eyebrow-accent">Assisted enquiry</p>
              <h3 class="type-h3">{assisted.title}</h3>
              <p class="type-small">{assisted.body}</p>
              <CtaLink
                label={hero.primaryCta.label}
                href={heroPrimaryHref}
                variant="link"
                icon="email"
                className="mt-auto pt-2"
                trackingKey="companies_assisted_email_click"
              />
            </div>
          )
        }
      </div>
    </div>
  </Section>

  {/* Teams & Project Stays */}
  <Section id="teams">
    <div class="grid items-start gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-20">
      <div class="flex flex-col gap-8">
        {
          teamsAndProjectsSection.image && (
            <Image
              src={teamsAndProjectsSection.image}
              format="webp"
              quality={75}
              loading="lazy"
              alt="A project team arriving at their business accommodation"
              widths={[480, 800, 1200, 1408]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              class="aspect-4/3 w-full rounded-xl object-cover object-[68%_center] lg:aspect-3/2"
            />
          )
        }
        <SectionHeader
          eyebrow="Teams & project stays"
          title={teamsAndProjectsSection.heading}
          lead={teamsAndProjectsSection.body}
          emphasizeLead
        />
      </div>
      <div
        class="bg-card border-border flex flex-col gap-7 rounded-xl border p-7 md:p-9 lg:sticky lg:top-28"
      >
        <p class="text-foreground text-sm font-semibold">
          To help us understand what you need, please include:
        </p>
        <ol class="border-border flex flex-col border-t">
          {
            requirements.map((item) => (
              <li class="border-border flex items-center gap-4 border-b py-4">
                <IconMark
                  icon={iconFor(item.label || item.detail, requirementIcons)}
                  size="sm"
                />
                <span class="flex flex-col gap-0.5">
                  {item.label && (
                    <span class="font-heading text-foreground text-[0.9375rem] font-semibold">
                      {item.label}
                    </span>
                  )}
                  <span class="type-small">{item.detail}</span>
                </span>
              </li>
            ))
          }
        </ol>
        <div
          class="flex flex-col gap-5 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-7 sm:gap-y-4"
        >
          <CtaLink
            label={teamsAndProjectsSection.primaryCta.label}
            href={teamPrimaryHref}
            variant="primary"
            icon="email"
            trackingKey="companies_team_email_click"
          />
          <CtaLink
            label={teamsAndProjectsSection.secondaryCta.label}
            href={teamSecondaryHref}
            variant="link"
            icon="whatsapp"
            external={teamSecondaryHref.startsWith("http")}
            trackingKey="companies_team_whatsapp_click"
          />
        </div>
      </div>
    </div>
  </Section>

  {
    finalCta.image && (
      <ClosingImageSection
        id="contact"
        eyebrow={finalCta.eyebrow}
        heading={finalCta.heading}
        body={finalCta.body}
        image={finalCta.image}
        imagePosition="top"
        desktopAspectRatio="video"
        imageAlt="Business travellers walking through a sunlit corporate lobby"
        actions={[
          {
            label: finalCta.primaryCta.label,
            href: finalPrimaryHref,
            variant: "secondary",
            icon: "email",
            trackingKey: "companies_final_email_click",
          },
          {
            label: finalCta.secondaryCta.label,
            href: finalSecondaryHref,
            variant: "link",
            icon: "arrow",
            external: finalSecondaryHref.startsWith("http"),
            trackingKey: "companies_final_whatsapp_click",
          },
        ]}
      />
    )
  }
</Layout>
