---
import { getEntry } from "astro:content";
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "@/layouts/Layout.astro";
import { Section } from "@/components/custom/section";
import { Hero } from "@/components/custom/hero";
import { getSiteSettings, resolveCtaLink } from "@/lib/content";
import { CtaLink } from "@/components/custom/cta-link";
import { FeatureList } from "@/components/custom/feature-list";
import { SectionIcon } from "@/components/custom/section-icon";
import { Users, Handshake, ClipboardList } from "lucide-react";

export const prerender = true;

const page = await getEntry("forCompaniesPage", "for-companies");
if (!page) throw new Error("For Companies page content not found");
const settings = await getSiteSettings();
const {
  hero,
  whoWeHelpSection,
  howAcosaHelpsSection,
  teamsAndProjectsSection,
  finalCta,
} = page.data;
const seo = page.data.seo;

// Cast: seoFields() in content.config.ts types image() as ZodTypeAny, which
// erases ImageMetadata from the inferred schema. The runtime value is one.
const ogImageUrl = seo?.ogImage
  ? (
      await getImage({
        src: seo.ogImage as ImageMetadata,
        width: 1200,
        height: 630,
      })
    ).src
  : undefined;

const email = settings.data.enquiryEmail;
const heroPrimaryHref = resolveCtaLink(hero.primaryCta.link, {
  email,
  emailSubject: "Corporate Accommodation Requirements",
  whatsappNumber: settings.data.defaultWhatsapp,
});
const heroSecondaryHref = resolveCtaLink(hero.secondaryCta.link, {
  email,
  emailSubject: "Corporate Accommodation Requirements",
  whatsappNumber: settings.data.defaultWhatsapp,
});
const teamPrimaryHref = resolveCtaLink(
  teamsAndProjectsSection.primaryCta.link,
  {
    email,
    emailSubject: "Team or Project Accommodation Request",
    whatsappNumber: settings.data.defaultWhatsapp,
  },
);
const teamSecondaryHref = resolveCtaLink(
  teamsAndProjectsSection.secondaryCta.link,
  {
    email,
    emailSubject: "Team or Project Accommodation Request",
    whatsappNumber: settings.data.defaultWhatsapp,
    whatsappMessage:
      "Hi ACOSA, I need assistance finding accommodation for a team or project.",
  },
);
const finalPrimaryHref = resolveCtaLink(finalCta.primaryCta.link, {
  email,
  emailSubject: "Corporate Accommodation Enquiry",
  whatsappNumber: settings.data.defaultWhatsapp,
});
const finalSecondaryHref = resolveCtaLink(finalCta.secondaryCta.link, {
  email,
  whatsappNumber: settings.data.defaultWhatsapp,
  whatsappMessage:
    "Hi ACOSA, I'm arranging business accommodation and would appreciate some assistance.",
});
---

<Layout
  title={seo?.title || "For Companies | ACOSA"}
  description={seo?.description ||
    "Corporate accommodation solutions for teams travelling across South Africa."}
  ogImage={ogImageUrl}
>
  <Hero
    eyebrow={hero.eyebrow}
    heading={hero.heading}
    body={hero.body}
    image={hero.image}
    imageAlt="A corporate booker arranging business accommodation"
    imageClassName="object-[72%_center] md:object-[68%_center] lg:object-center"
    primaryCta={{ label: hero.primaryCta.label, href: heroPrimaryHref }}
    secondaryCta={{ label: hero.secondaryCta.label, href: heroSecondaryHref }}
  />

  <Section className="mt-16">
    <div class="mx-auto max-w-3xl text-center">
      <div class="flex items-center justify-center gap-3">
        <SectionIcon icon={Users} />
        <h2 class="text-primary text-2xl font-bold md:text-3xl">
          {whoWeHelpSection.heading}
        </h2>
      </div>
      <p class="text-muted-foreground mt-3">{whoWeHelpSection.body}</p>
      <FeatureList
        className="mt-8"
        items={whoWeHelpSection.roles.map((role) => ({ text: role }))}
      />
    </div>
  </Section>

  <Section className="mt-16">
    <div class="mx-auto max-w-4xl">
      <div class="flex items-center gap-3">
        <SectionIcon icon={Handshake} />
        <h2 class="text-primary text-2xl font-bold md:text-3xl">
          {howAcosaHelpsSection.heading}
        </h2>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {
          howAcosaHelpsSection.features.map((feature) => (
            <article class="bg-card rounded-lg border p-5">
              <>
                <h3 class="text-primary font-semibold">{feature.title}</h3>
                <p class="text-muted-foreground mt-2 text-sm">{feature.body}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </Section>

  <Section className="mt-16">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      {
        teamsAndProjectsSection.image && (
          <Image
            src={teamsAndProjectsSection.image}
            alt="A project team staying in business accommodation"
            class="aspect-4/3 w-full rounded-2xl object-cover"
          />
        )
      }
      <div>
        <p class="text-muted-foreground text-sm font-semibold">
          To help us understand what you need, please include:
        </p>
        <div class="flex items-center gap-3">
          <SectionIcon icon={ClipboardList} />
          <h2 class="text-primary text-2xl font-bold md:text-3xl">
            {teamsAndProjectsSection.heading}
          </h2>
        </div>
        <p class="text-muted-foreground mt-3">{teamsAndProjectsSection.body}</p>
        <FeatureList
          className="mt-5"
          items={teamsAndProjectsSection.requirementsList.map((item) => ({ text: item }))}
        />
        <div class="mt-7 flex flex-wrap gap-3">
          <CtaLink
            label={teamsAndProjectsSection.primaryCta.label}
            href={teamPrimaryHref}
            variant="secondary"
            size="md"
            icon="arrow"
          />
          <CtaLink
            label={teamsAndProjectsSection.secondaryCta.label}
            href={teamSecondaryHref}
            variant="outline"
            size="md"
            icon="whatsapp"
            external
          />
        </div>
      </div>
    </div>
  </Section>

  <Section className="mt-16 mb-28">
    <div
      class="bg-primary text-primary-foreground mx-auto max-w-4xl rounded-2xl p-8 text-center md:p-12"
    >
      {finalCta.eyebrow && (
        <p class="text-primary-foreground/70 text-xs font-semibold tracking-wider uppercase">
          {finalCta.eyebrow}
        </p>
      )}
      <h2 class="text-2xl font-bold md:text-3xl">{finalCta.heading}</h2>
      <p class="mt-3 opacity-90">{finalCta.body}</p>

      <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
        <CtaLink
          label={finalCta.primaryCta.label}
          href={finalPrimaryHref}
          variant="inverted"
          size="md"
          icon="arrow"
        />

        <CtaLink
          label={finalCta.secondaryCta.label}
          href={finalSecondaryHref}
          variant="inverted"
          size="md"
          icon="whatsapp"
          external
          className="border border-background/30 bg-transparent text-background hover:bg-background/10"
        />
      </div>
    </div>
  </Section>
</Layout>
