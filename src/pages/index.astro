---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "@/layouts/Layout.astro";
import {
  getHomePage,
  getNodes,
  getFeaturedProperties,
  getSiteSettings,
  resolveCtaLink,
  propertyTypeLabel,
} from "@/lib/content";
import { Hero } from "@/components/custom/hero";
import { Section } from "@/components/custom/section";
import type { PopularNodeItem } from "@/components/custom/popular-nodes";
import {
  FeaturedProperties,
  type FeaturedPropertyItem,
} from "@/components/custom/featured-properties";
import { OwnerCta } from "@/components/custom/owner-cta";

export const prerender = true;

const page = await getHomePage();
const {
  hero,
  ownerCta,
  businessTravelSection,
  businessNodesSection,
  featuredPropertiesSection,
  corporateBookersSection,
  humanAssistanceSection,
  propertyOwnersSection,
  closingSection,
  seo,
} = page.data;

const businessNodes = await getNodes();
const featuredProperties = await getFeaturedProperties();
const settings = await getSiteSettings();
const ctaOptions = {
  email: settings.data.enquiryEmail,
  whatsappNumber: settings.data.defaultWhatsapp,
};
const corporateEmail = resolveCtaLink(
  corporateBookersSection.secondaryCta.link,
  { ...ctaOptions, emailSubject: "Corporate Accommodation Enquiry" },
);
const humanAssistanceLink = resolveCtaLink(humanAssistanceSection.cta.link, {
  ...ctaOptions,
  whatsappMessage: "Hi ACOSA, I need help finding business accommodation.",
});
const propertyOwnerPrimary = resolveCtaLink(
  propertyOwnersSection.primaryCta.link,
  ctaOptions,
);
const propertyOwnerSecondary = resolveCtaLink(
  propertyOwnersSection.secondaryCta.link,
  ctaOptions,
);
const closingLink = resolveCtaLink(closingSection.cta.link, ctaOptions);

// Cast: seoFields() in content.config.ts types image() as ZodTypeAny, which
// erases ImageMetadata from the inferred schema. The runtime value is one.
const ogImageUrl = seo?.ogImage
  ? (
      await getImage({
        src: seo.ogImage as ImageMetadata,
        width: 1200,
        height: 630,
      })
    ).src
  : undefined;

const siteBase: string = import.meta.env.SITE || Astro.url.origin;

const websiteSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Acosa",
  url: siteBase,
  description:
    seo?.description ||
    "Vetted business accommodation across South Africa's key corporate nodes.",
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${siteBase}/properties?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

const popularNodeItems: PopularNodeItem[] = await Promise.all(
  businessNodes.map(async (node) => {
    const img = await getImage({
      src: node.data.heroImage,
      widths: [400, 800],
      sizes: "(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw",
    });
    return {
      id: node.id,
      name: node.data.name,
      city: node.data.city,
      province: node.data.province,
      image: {
        src: img.src,
        srcSet: img.srcSet.attribute || undefined,
        sizes: img.attributes.sizes,
        width: img.attributes.width,
        height: img.attributes.height,
      },
      imageAlt: node.data.imageAlt || node.data.name,
    };
  }),
);

const featuredPropertyItems: FeaturedPropertyItem[] = await Promise.all(
  featuredProperties.map(async (property) => {
    const img = await getImage({
      src: property.data.heroImage,
      widths: [400, 800],
      sizes: "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw",
    });
    return {
      id: property.id,
      name: property.data.name,
      propertyTypeLabel: propertyTypeLabel(property.data.propertyType),
      approved: property.data.acosaApproved.approved,
      shortDescription: property.data.shortDescription,
      image: {
        src: img.src,
        srcSet: img.srcSet.attribute || undefined,
        sizes: img.attributes.sizes,
        width: img.attributes.width,
        height: img.attributes.height,
      },
      imageAlt: property.data.imageAlt || property.data.name,
    };
  }),
);
---

<Layout
  title={seo?.title || "Acosa | Vetted Business Accommodation in South Africa"}
  description={seo?.description ||
    "Vetted business accommodation across South Africa's key corporate nodes."}
  ogImage={ogImageUrl}
  jsonLd={websiteSchema}
>
  <Section fullWidth className="m-0">
    <Hero
      eyebrow={hero.eyebrow}
      heading={hero.heading}
      body={hero.body}
      image={hero.image}
      overlay={{
        opacity: hero.overlayOpacity,
      }}
      contentClassName="text-background"
      primaryCta={{
        label: hero.primaryCta.label,
        href: resolveCtaLink(hero.primaryCta.link, ctaOptions),
      }}
      secondaryCta={{
        label: hero.secondaryCta.label,
        href: resolveCtaLink(hero.secondaryCta.link, {
          ...ctaOptions,
          whatsappMessage:
            "Hi ACOSA, I'm looking for business accommodation and would appreciate some assistance.",
        }),
        external: hero.secondaryCta.link === "whatsapp",
      }}
    />
  </Section>

  <Section className="mt-28">
    <div class="grid gap-8 md:grid-cols-2 md:items-center">
      <div class="flex flex-col gap-4">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{businessTravelSection.eyebrow}</p>
        <h2 class="text-primary text-2xl font-bold md:text-3xl">{businessTravelSection.heading}</h2>
        <p class="text-muted-foreground text-sm md:text-base">{businessTravelSection.body}</p>
        <a href={businessTravelSection.cta.link} class="text-primary font-semibold no-underline">{businessTravelSection.cta.label} -&gt;</a>
      </div>
      {businessTravelSection.image && <Image src={businessTravelSection.image} alt="Business traveller working from accommodation" class="aspect-4/3 h-auto max-h-96 w-full rounded-2xl object-cover object-[65%_center] md:aspect-auto md:object-center" />}
    </div>
  </Section>

  <Section className="mt-28">
    <div class="flex flex-col gap-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{businessNodesSection.eyebrow}</p>
      <h2 class="text-primary text-2xl font-bold md:text-3xl">{businessNodesSection.heading}</h2>
      <p class="text-muted-foreground max-w-2xl text-sm md:text-base">{businessNodesSection.body}</p>
      <ul role="list" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {popularNodeItems.map((node) => (
          <li><a href={`/business-nodes/${node.province}/${node.id}`} class="border-border text-primary rounded-lg border p-4 font-semibold no-underline">Explore {node.name} -&gt;</a></li>
        ))}
      </ul>
      <a href={businessNodesSection.cta.link} class="text-primary font-semibold no-underline">{businessNodesSection.cta.label} -&gt;</a>
    </div>
  </Section>

  <Section className="mt-28">
    <div class="flex flex-col gap-2">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{featuredPropertiesSection.eyebrow}</p>
      <h2 class="text-primary text-2xl font-bold md:text-3xl">{featuredPropertiesSection.heading}</h2>
      <p class="text-muted-foreground text-sm md:text-base">{featuredPropertiesSection.body}</p>
    </div>
    <FeaturedProperties items={featuredPropertyItems} />
  </Section>

  <Section className="mt-28">
    <div class="grid gap-8 md:grid-cols-2 md:items-center">
      {corporateBookersSection.image && <Image src={corporateBookersSection.image} alt="Corporate booker reviewing accommodation options" class="aspect-4/3 h-auto max-h-96 w-full rounded-2xl object-cover object-[65%_center] md:aspect-auto md:object-center" />}
      <div class="flex flex-col gap-4">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{corporateBookersSection.eyebrow}</p>
        <h2 class="text-primary text-2xl font-bold md:text-3xl">{corporateBookersSection.heading}</h2>
        <p class="text-muted-foreground text-sm md:text-base">{corporateBookersSection.body}</p>
        <div class="flex flex-wrap gap-3"><a href={resolveCtaLink(corporateBookersSection.primaryCta.link, ctaOptions)} class="bg-primary text-primary-foreground rounded-full px-5 py-2.5 text-sm font-medium no-underline">{corporateBookersSection.primaryCta.label}</a><a href={corporateEmail} class="border-border text-primary rounded-full border px-5 py-2.5 text-sm font-medium no-underline">{corporateBookersSection.secondaryCta.label}</a></div>
      </div>
    </div>
  </Section>

  <Section className="mt-28">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-primary text-2xl font-bold md:text-3xl">
        {humanAssistanceSection.heading}
      </h2><p class="text-muted-foreground mt-3">
        {humanAssistanceSection.body}
      </p><a
        href={humanAssistanceLink}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-secondary text-secondary-foreground mt-6 inline-flex rounded-full px-5 py-2.5 text-sm font-medium no-underline"
        >{humanAssistanceSection.cta.label}</a>
    </div>
  </Section>

  <Section fullWidth className="m-0">
    <OwnerCta
      heading={propertyOwnersSection.heading || ownerCta.heading}
      body={propertyOwnersSection.body || ownerCta.body}
      buttonLabel={propertyOwnersSection.primaryCta.label ||
        ownerCta.buttonLabel}
      secondButtonLabel={propertyOwnersSection.secondaryCta.label ||
        ownerCta.secondButtonLabel}
      primaryHref={propertyOwnerPrimary}
      secondaryHref={propertyOwnerSecondary}
    />
  </Section>

  {closingSection.image && <Section fullWidth className="m-0"><div class="relative"><Image src={closingSection.image} alt="Traveller relaxing after a business day" class="aspect-4/3 h-auto max-h-128 w-full object-cover object-[65%_center] md:aspect-auto md:h-96 md:object-center" /><div class="absolute inset-0 flex flex-col items-center justify-center gap-4 bg-black/40 p-6 text-center text-white"><h2 class="text-2xl font-bold md:text-3xl">{closingSection.heading}</h2><p class="max-w-2xl text-sm md:text-base">{closingSection.body}</p><a href={closingLink} class="rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-black no-underline">{closingSection.cta.label}</a></div></div></Section>}
</Layout>
