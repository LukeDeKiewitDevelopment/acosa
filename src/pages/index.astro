---
import { Image, getImage } from "astro:assets";
import { getEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import Layout from "@/layouts/Layout.astro";
import {
  getHomePage,
  getFeaturedProperties,
  getNodes,
  getPublishedProperties,
  getSiteSettings,
  resolveCtaLink,
  propertyTypeLabel,
} from "@/lib/content";
import { Hero } from "@/components/custom/hero";
import { Section } from "@/components/custom/section";
import {
  FeaturedProperties,
  type FeaturedPropertyItem,
} from "@/components/custom/featured-properties";
import { OwnerCta } from "@/components/custom/owner-cta";
import {
  PropertySearch,
  type PropertySearchItem,
} from "@/components/custom/property-search";
import { toFeaturedPropertyCard } from "@/lib/featured-property-card";
import { CtaLink } from "@/components/custom/cta-link";
import { TextLink } from "@/components/custom/text-link";

export const prerender = true;

const page = await getHomePage();
const {
  hero,
  ownerCta,
  businessTravelSection,
  businessNodesSection,
  featuredPropertiesSection,
  corporateBookersSection,
  humanAssistanceSection,
  propertyOwnersSection,
  closingSection,
  seo,
} = page.data;

const featuredProperties = await getFeaturedProperties();
const publishedProperties = await getPublishedProperties();
const businessNodes = (await getNodes()).map((node) => ({
  id: node.id,
  name: node.data.name,
}));
const settings = await getSiteSettings();
const ctaOptions = {
  email: settings.data.enquiryEmail,
  whatsappNumber: settings.data.defaultWhatsapp,
};
const corporateEmail = resolveCtaLink(
  corporateBookersSection.secondaryCta.link,
  { ...ctaOptions, emailSubject: "Corporate Accommodation Enquiry" },
);
const humanAssistanceLink = resolveCtaLink(humanAssistanceSection.cta.link, {
  ...ctaOptions,
  whatsappMessage: "Hi ACOSA, I need help finding business accommodation.",
});
const propertyOwnerPrimary = resolveCtaLink(
  propertyOwnersSection.primaryCta.link,
  ctaOptions,
);
const propertyOwnerSecondary = resolveCtaLink(
  propertyOwnersSection.secondaryCta.link,
  ctaOptions,
);
const closingLink = resolveCtaLink(closingSection.cta.link, ctaOptions);

const propertySearchItems: PropertySearchItem[] = await Promise.all(
  publishedProperties.map(async (property) => {
    const img = await getImage({
      src: property.data.heroImage,
      widths: [400, 800],
      sizes: "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw",
    });
    const businessNode = await getEntry(property.data.businessNode);
    return {
      id: property.id,
      name: property.data.name,
      province: property.data.province,
      businessNode: property.data.businessNode.id,
      businessNodeLabel: businessNode?.data.name ?? property.data.businessNode.id,
      locationAddress: property.data.location.address,
      propertyType: property.data.propertyType,
      propertyTypeLabel: propertyTypeLabel(property.data.propertyType),
      approved: property.data.acosaApproved.approved,
      shortDescription: property.data.shortDescription,
      image: {
        src: img.src,
        srcSet: img.srcSet.attribute || undefined,
        sizes: img.attributes.sizes,
        width: img.attributes.width,
        height: img.attributes.height,
      },
      imageAlt: property.data.imageAlt || property.data.name,
    };
  }),
);

// Cast: seoFields() in content.config.ts types image() as ZodTypeAny, which
// erases ImageMetadata from the inferred schema. The runtime value is one.
const ogImageUrl = seo?.ogImage
  ? (
      await getImage({
        src: seo.ogImage as ImageMetadata,
        width: 1200,
        height: 630,
      })
    ).src
  : undefined;

const siteBase: string = import.meta.env.SITE || Astro.url.origin;

const websiteSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "ACOSA",
  url: siteBase,
  description:
    seo?.description ||
    "Vetted business accommodation across South Africa's key corporate nodes.",
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${siteBase}/properties?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

const featuredPropertyItems: FeaturedPropertyItem[] = await Promise.all(
  featuredProperties.map(async (property) => {
    const img = await getImage({
      src: property.data.heroImage,
      widths: [400, 800],
      sizes: "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw",
    });
    const businessNode = await getEntry(property.data.businessNode);
    return toFeaturedPropertyCard({
      property,
      image: {
        src: img.src,
        srcSet: img.srcSet.attribute || undefined,
        sizes: img.attributes.sizes,
        width: img.attributes.width,
        height: img.attributes.height,
      },
      businessNodeLabel: businessNode?.data.name ?? property.data.businessNode.id,
      propertyTypeLabel: propertyTypeLabel(property.data.propertyType),
    });
  }),
);
---

<Layout
  title={seo?.title || "ACOSA | Vetted Business Accommodation in South Africa"}
  description={seo?.description ||
    "Vetted business accommodation across South Africa's key corporate nodes."}
  ogImage={ogImageUrl}
  jsonLd={websiteSchema}
>
  <Section fullWidth className="!m-0">
    <Hero
      eyebrow={hero.eyebrow}
      heading={hero.heading}
      body={hero.body}
      image={hero.image}
      imageClassName="object-[72%_center] md:object-[68%_center] lg:object-center"
      overlay={{
        opacity: hero.overlayOpacity,
      }}
      contentClassName="text-background"
      primaryCta={{
        label: hero.primaryCta.label,
        href: resolveCtaLink(hero.primaryCta.link, ctaOptions),
      }}
      secondaryCta={{
        label: hero.secondaryCta.label,
        href: resolveCtaLink(hero.secondaryCta.link, {
          ...ctaOptions,
          whatsappMessage:
            "Hi ACOSA, I'm looking for business accommodation and would appreciate some assistance.",
        }),
        external: hero.secondaryCta.link === "whatsapp",
      }}
    />
  </Section>

  <Section className="mt-28">
    <div class="grid gap-8 md:grid-cols-2 md:items-center">
      <div class="flex flex-col gap-4">
        <p
          class="text-muted-foreground text-xs font-semibold tracking-wider uppercase"
        >
          {businessTravelSection.eyebrow}
        </p>
        <h2 class="text-primary text-2xl font-bold md:text-3xl">
          {businessTravelSection.heading}
        </h2>
        <p class="text-muted-foreground text-sm md:text-base">
          {businessTravelSection.body}
        </p>
        <TextLink
          label={businessTravelSection.cta.label}
          href={businessTravelSection.cta.link}
        />
      </div>
      {businessTravelSection.image && <Image src={businessTravelSection.image} alt="Business traveller working from accommodation" class="aspect-4/3 h-auto max-h-96 w-full rounded-2xl object-cover object-[65%_center] md:aspect-auto md:object-center" />}
    </div>
  </Section>

  <Section className="mt-24">
    <div class="flex flex-col gap-6">
      <p
        class="text-muted-foreground text-xs font-semibold tracking-wider uppercase"
      >
        {businessNodesSection.eyebrow}
      </p>
      <h2 class="text-primary text-2xl font-bold md:text-3xl">
        {businessNodesSection.heading}
      </h2>
      <p class="text-muted-foreground max-w-2xl text-sm md:text-base">
        {businessNodesSection.body}
      </p>
      <PropertySearch
        client:load
        items={propertySearchItems}
        businessNodes={businessNodes}
      />
      <TextLink
        label={businessNodesSection.cta.label}
        href={businessNodesSection.cta.link}
      />
    </div>
  </Section>

  <Section className="mt-28">
    <div class="flex flex-col gap-2">
      <p
        class="text-muted-foreground text-xs font-semibold tracking-wider uppercase"
      >
        {featuredPropertiesSection.eyebrow}
      </p>
      <h2 class="text-primary text-2xl font-bold md:text-3xl">
        {featuredPropertiesSection.heading}
      </h2>
      <p class="text-muted-foreground text-sm md:text-base">
        {featuredPropertiesSection.body}
      </p>
    </div>
    <FeaturedProperties items={featuredPropertyItems} />
  </Section>

  <Section className="mt-28">
    <div class="grid gap-8 md:grid-cols-2 md:items-center">
      {corporateBookersSection.image && <Image src={corporateBookersSection.image} alt="Corporate booker reviewing accommodation options" class="aspect-4/3 h-auto max-h-96 w-full rounded-2xl object-cover object-[65%_center] md:aspect-auto md:object-center" />}
      <div class="flex flex-col gap-4">
        <p
          class="text-muted-foreground text-xs font-semibold tracking-wider uppercase"
        >
          {corporateBookersSection.eyebrow}
        </p>
        <h2 class="text-primary text-2xl font-bold md:text-3xl">
          {corporateBookersSection.heading}
        </h2>
        <p class="text-muted-foreground text-sm md:text-base">
          {corporateBookersSection.body}
        </p>
        <div class="flex flex-wrap gap-3">
          <CtaLink
            label={corporateBookersSection.primaryCta.label}
            href={resolveCtaLink(
              corporateBookersSection.primaryCta.link,
              ctaOptions,
            )}
            variant="primary"
            size="md"
            icon="arrow"
          />
          <CtaLink
            label={corporateBookersSection.secondaryCta.label}
            href={corporateEmail}
            variant="outline"
            size="md"
          />
        </div>
      </div>
    </div>
  </Section>

  <Section className="mt-28">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-primary text-2xl font-bold md:text-3xl">
        {humanAssistanceSection.heading}
      </h2><p class="text-muted-foreground mt-3">
        {humanAssistanceSection.body}
      </p><CtaLink
        label={humanAssistanceSection.cta.label}
        href={humanAssistanceLink}
        variant="secondary"
        size="md"
        icon="whatsapp"
        external
        className="mt-6"
      />
    </div>
  </Section>

  <Section fullWidth className="m-0 mt-20 md:mt-28">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-12">
      {propertyOwnersSection.image && (
        <Image
          src={propertyOwnersSection.image}
          alt="An independent accommodation host welcoming a business traveller"
          class="aspect-4/3 h-auto w-full rounded-2xl object-cover object-[22%_center] sm:object-[28%_center] md:object-[35%_center] lg:aspect-auto lg:h-136 lg:object-[28%_center]"
        />
      )}
      <OwnerCta
        eyebrow={propertyOwnersSection.eyebrow}
        heading={propertyOwnersSection.heading || ownerCta.heading}
        body={propertyOwnersSection.body || ownerCta.body}
        buttonLabel={propertyOwnersSection.primaryCta.label ||
          ownerCta.buttonLabel}
        secondButtonLabel={propertyOwnersSection.secondaryCta.label ||
          ownerCta.secondButtonLabel}
        primaryHref={propertyOwnerPrimary}
        secondaryHref={propertyOwnerSecondary}
      />
    </div>
  </Section>

  {closingSection.image && <Section fullWidth className="m-0 mt-20 md:mt-28"><div class="relative"><Image src={closingSection.image} alt="Traveller relaxing after a business day" class="aspect-4/3 h-auto max-h-128 w-full object-cover object-[65%_center] md:aspect-auto md:h-96 md:object-center" /><div class="absolute inset-0 flex flex-col items-center justify-center gap-4 bg-black/40 p-6 text-center text-white md:p-10"><h2 class="text-2xl font-bold md:text-3xl">{closingSection.heading}</h2><p class="max-w-2xl text-sm md:text-base">{closingSection.body}</p><CtaLink label={closingSection.cta.label} href={closingLink} variant="inverted" size="md" icon="arrow" /></div></div></Section>}
</Layout>
