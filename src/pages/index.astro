---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "@/layouts/Layout.astro";
import {
  getHomePage,
  getFeaturedProperties,
  getNodes,
  getPublishedProperties,
  getSiteSettings,
  resolveCtaLink,
  buildPropertyListingItems,
} from "@/lib/content";
import { Hero } from "@/components/custom/hero";
import { Section } from "@/components/custom/section";
import { SectionHeader } from "@/components/custom/section-header";
import { PropertyGrid } from "@/components/custom/property-card";
import { PropertySearch } from "@/components/custom/property-search";
import { CtaLink } from "@/components/custom/cta-link";
import { TextLink } from "@/components/custom/text-link";
import { getCollection } from "astro:content";
import { tagIcon } from "@/lib/tag-icons";

export const prerender = true;

/* Home — the approved section order, restyled to the Creative Direction
   Blueprint (Page 01). Layout changes are limited to what the brief asks
   for: the hero gives Find Accommodation clear priority over the owner
   route, the corporate pathway is a distinct editorial moment, and the
   property-owner section is a deliberate shift to a new audience. */

const page = await getHomePage();
const {
  hero,
  ownerCta,
  businessTravelSection,
  businessNodesSection,
  featuredPropertiesSection,
  corporateBookersSection,
  humanAssistanceSection,
  propertyOwnersSection,
  closingSection,
  seo,
} = page.data;

const [featuredItems, searchItems, nodes, settings] = await Promise.all([
  getFeaturedProperties().then(buildPropertyListingItems),
  getPublishedProperties().then(buildPropertyListingItems),
  getNodes(),
  getSiteSettings(),
]);
// Business Traveller Essentials named in the section copy, in copy order,
// with their CMS icons.
const ESSENTIAL_IDS = [
  "reliable-wifi",
  "workspace-friendly",
  "secure-parking",
  "backup-power",
  "breakfast",
];
const essentialTags = await getCollection("essentials");
const travelEssentials = ESSENTIAL_IDS.map((id) =>
  essentialTags.find((tag) => tag.id === id),
)
  .filter((tag) => tag !== undefined)
  .map((tag) => ({ name: tag.data.name, Icon: tagIcon(tag.data.icon) }));

const businessNodes = nodes.map((node) => ({
  id: node.id,
  name: node.data.name,
}));

const ctaOptions = {
  email: settings.data.enquiryEmail,
  whatsappNumber: settings.data.defaultWhatsapp,
};
const corporateEmail = resolveCtaLink(
  corporateBookersSection.secondaryCta.link,
  { ...ctaOptions, emailSubject: "Corporate Accommodation Enquiry" },
);
const humanAssistanceLink = resolveCtaLink(humanAssistanceSection.cta.link, {
  ...ctaOptions,
  whatsappMessage: "Hi ACOSA, I need help finding business accommodation.",
});
const ownerPrimaryHref = resolveCtaLink(
  propertyOwnersSection.primaryCta.link,
  ctaOptions,
);
const ownerSecondaryHref = resolveCtaLink(
  propertyOwnersSection.secondaryCta.link,
  ctaOptions,
);

// Cast: seoFields() in content.config.ts types image() as ZodTypeAny, which
// erases ImageMetadata from the inferred schema. The runtime value is one.
const ogImageUrl = seo?.ogImage
  ? (
      await getImage({
        src: seo.ogImage as ImageMetadata,
        width: 1200,
        height: 630,
      })
    ).src
  : undefined;

const siteBase: string = import.meta.env.SITE || Astro.url.origin;

const websiteSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "ACOSA",
  url: siteBase,
  description:
    seo?.description ||
    "Vetted business accommodation across South Africa's key corporate nodes.",
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${siteBase}/properties?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};
---

<Layout
  title={seo?.title || "ACOSA | Vetted Business Accommodation in South Africa"}
  description={seo?.description ||
    "Vetted business accommodation across South Africa's key corporate nodes."}
  ogImage={ogImageUrl}
  jsonLd={websiteSchema}
>
  {
    /* 01 — Cinematic hero. Find Accommodation dominates; the owner route is a
      quieter text link so the two audiences don't compete equally. */
  }
  <Hero
    size="cinematic"
    align="left"
    eyebrow={hero.eyebrow}
    heading={hero.heading}
    body={hero.body}
    image={hero.image}
    imageAlt="An ACOSA host welcoming a business traveller at an independent guesthouse"
    imageClassName="object-[76%_center] sm:object-[74%_center] lg:object-[70%_center]"
    overlay={{ opacity: Math.max(hero.overlayOpacity ?? 0, 94) }}
    primaryCta={{
      label: hero.primaryCta.label,
      href: resolveCtaLink(hero.primaryCta.link, ctaOptions),
    }}
    secondaryCta={{
      label: hero.secondaryCta.label,
      href: resolveCtaLink(hero.secondaryCta.link, {
        ...ctaOptions,
        whatsappMessage:
          "Hi ACOSA, I'm looking for business accommodation and would appreciate some assistance.",
      }),
      external: hero.secondaryCta.link === "whatsapp",
    }}
    secondaryStyle="link"
  />

  {/* Built around business travel (editorial split) */}
  <Section>
    <div
      class="grid items-center gap-10 md:grid-cols-2 lg:grid-cols-[1fr_1.1fr] lg:gap-20"
    >
      <SectionHeader
        eyebrow={businessTravelSection.eyebrow}
        title={businessTravelSection.heading}
        lead={businessTravelSection.body}
      >
        {
          travelEssentials.length > 0 && (
            <ul
              aria-label="Business traveller essentials"
              class="border-border mt-2 grid grid-cols-2 gap-x-6 gap-y-4 border-y py-6 sm:grid-cols-3"
            >
              {travelEssentials.map(({ name, Icon }) => (
                <li class="text-foreground flex items-center gap-3 text-sm font-medium">
                  <span class="bg-gold/12 text-gold-ink inline-flex size-9 shrink-0 items-center justify-center rounded-lg">
                    <Icon className="size-4" aria-hidden="true" />
                  </span>
                  {name}
                </li>
              ))}
            </ul>
          )
        }
        <TextLink
          label={businessTravelSection.cta.label}
          href={businessTravelSection.cta.link}
          className="mt-2"
        />
      </SectionHeader>
      {
        businessTravelSection.image && (
          <Image
            src={businessTravelSection.image}
            alt="A business traveller working at the desk of her guesthouse room"
            widths={[480, 800, 1200, 1408]}
            sizes="(min-width: 768px) 50vw, 100vw"
            class="aspect-4/3 w-full rounded-xl object-cover object-[60%_center] md:aspect-5/4 lg:aspect-4/3"
          />
        )
      }
    </div>
  </Section>

  {/* Location matters: business nodes + property search */}
  <Section id="business-nodes" tone="warm">
    <div class="flex flex-col gap-10 md:gap-12">
      <div
        class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between"
      >
        <SectionHeader
          eyebrow={businessNodesSection.eyebrow}
          title={businessNodesSection.heading}
          lead={businessNodesSection.body}
        />
        <TextLink
          label={businessNodesSection.cta.label}
          href={businessNodesSection.cta.link}
          className="shrink-0"
        />
      </div>
      <PropertySearch
        client:load
        items={searchItems}
        businessNodes={businessNodes}
      />
    </div>
  </Section>

  {/* Featured properties */}
  {
    featuredItems.length > 0 && (
      <Section id="featured-properties">
        <div class="flex flex-col gap-10 md:gap-12">
          <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
            <SectionHeader
              eyebrow={featuredPropertiesSection.eyebrow}
              title={featuredPropertiesSection.heading}
              lead={featuredPropertiesSection.body}
            />
            <TextLink
              label="View all properties"
              href="/properties"
              className="shrink-0"
            />
          </div>
          <PropertyGrid items={featuredItems} />
        </div>
      </Section>
    )
  }

  {/* Corporate booking pathway: a distinct editorial moment */}
  <Section id="corporate" tone="warm">
    <div
      class="grid items-center gap-10 md:grid-cols-2 lg:grid-cols-[1.15fr_1fr] lg:gap-20"
    >
      {
        corporateBookersSection.image && (
          <Image
            src={corporateBookersSection.image}
            alt="A corporate booker reviewing accommodation options for a colleague"
            widths={[480, 800, 1200, 1376]}
            sizes="(min-width: 768px) 55vw, 100vw"
            class="order-last aspect-4/3 w-full rounded-xl object-cover object-[78%_center] md:order-first md:aspect-5/4 lg:aspect-4/3"
          />
        )
      }
      <SectionHeader
        eyebrow={corporateBookersSection.eyebrow}
        title={corporateBookersSection.heading}
        lead={corporateBookersSection.body}
      >
        <div
          class="mt-3 flex flex-col gap-5 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-7 sm:gap-y-4"
        >
          <CtaLink
            label={corporateBookersSection.primaryCta.label}
            href={resolveCtaLink(
              corporateBookersSection.primaryCta.link,
              ctaOptions,
            )}
            variant="primary"
            icon="arrow"
            trackingKey="home_corporate_click"
          />
          <CtaLink
            label={corporateBookersSection.secondaryCta.label}
            href={corporateEmail}
            variant="link"
            icon="email"
            trackingKey="home_corporate_email_click"
          />
        </div>
      </SectionHeader>
    </div>
  </Section>

  {/* Human assistance (centred, as in the approved layout) */}
  <Section>
    <div class="mx-auto flex max-w-2xl flex-col items-center gap-5 text-center">
      <h2 class="type-h2">{humanAssistanceSection.heading}</h2>
      <p class="type-lead">{humanAssistanceSection.body}</p>
      <CtaLink
        label={humanAssistanceSection.cta.label}
        href={humanAssistanceLink}
        variant="secondary"
        icon="whatsapp"
        external={humanAssistanceLink.startsWith("http")}
        trackingKey="home_assistance_whatsapp_click"
        className="mt-2"
      />
    </div>
  </Section>

  {
    /* Property-owner invitation: a deliberate shift to a new audience.
      Full-bleed ivory split with the welcoming-host photograph. */
  }
  <Section spacing="none" fullWidth id="for-accommodation-providers">
    <div class="surface-ivory grid lg:min-h-160 lg:grid-cols-2">
      {
        propertyOwnersSection.image && (
          <div class="relative aspect-4/3 sm:aspect-video lg:aspect-auto">
            <Image
              src={propertyOwnersSection.image}
              alt="An independent accommodation host welcoming a business traveller"
              widths={[480, 800, 1200, 1408]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              class="absolute inset-0 h-full w-full object-cover object-[76%_center] sm:object-[74%_center] lg:object-[70%_center]"
            />
          </div>
        )
      }
      <div class="flex items-center">
        <div
          class="flex w-full max-w-xl flex-col gap-5 px-4 py-14 sm:px-6 md:py-20 lg:px-16 xl:px-20"
        >
          <p class="eyebrow">{propertyOwnersSection.eyebrow}</p>
          <h2 class="type-h2">
            {propertyOwnersSection.heading || ownerCta.heading}
          </h2>
          <p class="type-lead">{propertyOwnersSection.body || ownerCta.body}</p>
          <div
            class="mt-3 flex flex-col gap-5 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-7 sm:gap-y-4"
          >
            <CtaLink
              label={propertyOwnersSection.primaryCta.label ||
                ownerCta.buttonLabel}
              href={ownerPrimaryHref}
              variant="primary"
              icon="arrow"
              trackingKey="home_list_property_click"
            />
            <CtaLink
              label={propertyOwnersSection.secondaryCta.label ||
                ownerCta.secondButtonLabel}
              href={ownerSecondaryHref}
              variant="link"
              trackingKey="home_whats_included_click"
            />
          </div>
        </div>
      </div>
    </div>
  </Section>
  {/* Closing: beyond working hours */}
  {
    closingSection.image && (
      <Section spacing="none" fullWidth>
        <div class="surface-navy relative isolate overflow-hidden">
          <Image
            src={closingSection.image}
            alt="A traveller relaxing on the patio of her guesthouse after a business day"
            widths={[480, 800, 1200, 1408, 1920]}
            sizes="100vw"
            class="absolute inset-0 -z-10 h-full w-full object-cover object-[72%_center]"
          />
          <div
            aria-hidden="true"
            class="from-navy/90 via-navy/60 to-navy/10 absolute inset-0 -z-10 bg-linear-to-t md:bg-linear-to-r md:to-transparent"
          />
          <div class="container-page flex min-h-120 items-end py-14 md:min-h-136 md:items-center md:py-20">
            <div class="flex max-w-lg flex-col gap-5">
              <h2 class="type-h2">{closingSection.heading}</h2>
              <p class="type-lead">{closingSection.body}</p>
              <CtaLink
                label={closingSection.cta.label}
                href={resolveCtaLink(closingSection.cta.link, ctaOptions)}
                variant="secondary"
                icon="arrow"
                className="mt-2 w-fit"
              />
            </div>
          </div>
        </div>
      </Section>
    )
  }
</Layout>
