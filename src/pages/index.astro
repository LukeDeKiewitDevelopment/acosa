---
import { getCollection } from "astro:content";
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "@/layouts/Layout.astro";
import {
  getHomePage,
  getNodes,
  getPopularNodes,
  getFeaturedProperties,
  getGeneralTestimonials,
  getSiteSettings,
  getActiveProvinces,
  buildSearchNodes,
  whatsappLink,
  mailtoLink,
  resolveCtaLink,
  provinceLabel,
  propertyTypeLabel,
} from "@/lib/content";
import { Hero } from "@/components/custom/hero";
import { Section } from "@/components/custom/section";
import { BusinessNodeSearch } from "@/components/custom/business-node-search";
import { TrustIcons } from "@/components/custom/trust-icons";
import {
  PopularNodes,
  type PopularNodeItem,
} from "@/components/custom/popular-nodes";
import {
  FeaturedProperties,
  type FeaturedPropertyItem,
} from "@/components/custom/featured-properties";
import { VettingPreview } from "@/components/custom/vetting-preview";
import { OwnerCta } from "@/components/custom/owner-cta";

export const prerender = true;

const page = await getHomePage();
const {
  hero,
  founderStrip,
  whyAcosaPreview,
  ownerCta,
  businessTravelSection,
  businessNodesSection,
  featuredPropertiesSection,
  corporateBookersSection,
  humanAssistanceSection,
  propertyOwnersSection,
  closingSection,
  seo,
} = page.data;

const popularNodes = await getPopularNodes();
const businessNodes = await getNodes();
const featuredProperties = await getFeaturedProperties();
const essentials = await getCollection("essentials");
const testimonials = await getGeneralTestimonials();
const settings = await getSiteSettings();
const provinces = await getActiveProvinces();

const searchNodes = await buildSearchNodes();
const ctaOptions = {
  email: settings.data.enquiryEmail,
  whatsappNumber: settings.data.defaultWhatsapp,
};
const corporateEmail = resolveCtaLink(
  corporateBookersSection.secondaryCta.link,
  { ...ctaOptions, emailSubject: "Corporate Accommodation Enquiry" },
);
const humanAssistanceLink = resolveCtaLink(humanAssistanceSection.cta.link, {
  ...ctaOptions,
  whatsappMessage: "Hi ACOSA, I need help finding business accommodation.",
});
const propertyOwnerPrimary = resolveCtaLink(
  propertyOwnersSection.primaryCta.link,
  ctaOptions,
);
const propertyOwnerSecondary = resolveCtaLink(
  propertyOwnersSection.secondaryCta.link,
  ctaOptions,
);
const closingLink = resolveCtaLink(closingSection.cta.link, ctaOptions);

// Cast: seoFields() in content.config.ts types image() as ZodTypeAny, which
// erases ImageMetadata from the inferred schema. The runtime value is one.
const ogImageUrl = seo?.ogImage
  ? (
      await getImage({
        src: seo.ogImage as ImageMetadata,
        width: 1200,
        height: 630,
      })
    ).src
  : undefined;

const siteBase: string = import.meta.env.SITE || Astro.url.origin;

const websiteSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Acosa",
  url: siteBase,
  description:
    seo?.description ||
    "Vetted business accommodation across South Africa's key corporate nodes.",
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${siteBase}/properties?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

const popularNodeItems: PopularNodeItem[] = await Promise.all(
  popularNodes.map(async (node) => {
    const img = await getImage({
      src: node.data.heroImage,
      widths: [400, 800],
      sizes: "(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw",
    });
    return {
      id: node.id,
      name: node.data.name,
      city: node.data.city,
      province: node.data.province,
      image: {
        src: img.src,
        srcSet: img.srcSet.attribute || undefined,
        sizes: img.attributes.sizes,
        width: img.attributes.width,
        height: img.attributes.height,
      },
      imageAlt: node.data.imageAlt || node.data.name,
    };
  }),
);

const featuredPropertyItems: FeaturedPropertyItem[] = await Promise.all(
  featuredProperties.map(async (property) => {
    const img = await getImage({
      src: property.data.heroImage,
      widths: [400, 800],
      sizes: "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw",
    });
    return {
      id: property.id,
      name: property.data.name,
      propertyTypeLabel: propertyTypeLabel(property.data.propertyType),
      approved: property.data.acosaApproved.approved,
      shortDescription: property.data.shortDescription,
      image: {
        src: img.src,
        srcSet: img.srcSet.attribute || undefined,
        sizes: img.attributes.sizes,
        width: img.attributes.width,
        height: img.attributes.height,
      },
      imageAlt: property.data.imageAlt || property.data.name,
    };
  }),
);
---

<Layout
  title={seo?.title || "Acosa | Vetted Business Accommodation in South Africa"}
  description={seo?.description ||
    "Vetted business accommodation across South Africa's key corporate nodes."}
  ogImage={ogImageUrl}
  jsonLd={websiteSchema}
>
  <Section fullWidth className="m-0">
    <Hero
      eyebrow={hero.eyebrow}
      heading={hero.heading}
      body={hero.body}
      image={hero.image}
      overlay={{
        opacity: hero.overlayOpacity,
      }}
      contentClassName="text-background"
      primaryCta={{
        label: hero.primaryCta.label,
        href: resolveCtaLink(hero.primaryCta.link, ctaOptions),
      }}
      secondaryCta={{
        label: hero.secondaryCta.label,
        href: resolveCtaLink(hero.secondaryCta.link, {
          ...ctaOptions,
          whatsappMessage:
            "Hi ACOSA, I'm looking for business accommodation and would appreciate some assistance.",
        }),
        external: hero.secondaryCta.link === "whatsapp",
      }}
    />
  </Section>

  <Section className="mt-28">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <div>
        <p
          class="text-muted-foreground text-xs font-semibold tracking-wider uppercase"
        >
          {businessTravelSection.eyebrow}
        </p>
        <h2 class="text-primary mt-2 text-2xl font-bold md:text-3xl">
          {businessTravelSection.heading}
        </h2>
        <p class="text-muted-foreground mt-4">{businessTravelSection.body}</p>
        <a
          href={businessTravelSection.cta.link}
          class="text-secondary mt-6 inline-flex items-center gap-2 text-sm font-medium no-underline hover:underline"
          >{businessTravelSection.cta.label}<span aria-hidden="true">→</span></a
        >
      </div>
      {
        businessTravelSection.image && (
          <Image
            src={businessTravelSection.image}
            alt="Business traveller working from a practical accommodation workspace"
            class="aspect-4/3 w-full rounded-2xl object-cover"
          />
        )
      }
    </div>
  </Section>

  <Section className="mt-28">
    <BusinessNodeSearch nodes={searchNodes} client:load />
  </Section>

  <Section className="mt-28">
    <div class="space-y-8">
      <div class="mx-auto max-w-3xl text-center">
        <p
          class="text-muted-foreground text-xs font-semibold tracking-wider uppercase"
        >
          {businessNodesSection.eyebrow}
        </p>
        <h2 class="text-primary mt-2 text-2xl font-bold md:text-3xl">
          {businessNodesSection.heading}
        </h2>
        <p class="text-muted-foreground mt-3">{businessNodesSection.body}</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          businessNodes.map((node) => (
            <a
              href={`/business-nodes/${node.data.province}/${node.id}`}
              class="bg-card hover:border-secondary rounded-lg border p-5 no-underline transition-colors"
            >
              <>
                <h3 class="text-primary font-semibold">{node.data.name}</h3>
                <span class="text-secondary mt-3 inline-flex items-center gap-2 text-sm">
                  Explore {node.data.name}
                  <span aria-hidden="true">→</span>
                </span>
              </>
            </a>
          ))
        }
      </div>
      <a
        href={businessNodesSection.cta.link}
        class="text-secondary mx-auto inline-flex items-center gap-2 text-sm font-medium no-underline hover:underline"
        >{businessNodesSection.cta.label}<span aria-hidden="true">→</span></a
      >
    </div>
  </Section>

  <Section className="mt-28">
    <div class="space-y-5">
      <p
        class="text-muted-foreground text-xs font-semibold tracking-wider uppercase"
      >
        {featuredPropertiesSection.eyebrow}
      </p>
      <h2 class="text-primary text-2xl font-bold md:text-3xl">
        {featuredPropertiesSection.heading}
      </h2>
      <p class="text-muted-foreground">{featuredPropertiesSection.body}</p>
      <FeaturedProperties items={featuredPropertyItems} />
    </div>
  </Section>

  <Section className="mt-28">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <div>
        <p
          class="text-muted-foreground text-xs font-semibold tracking-wider uppercase"
        >
          {corporateBookersSection.eyebrow}
        </p>
        <h2 class="text-primary mt-2 text-2xl font-bold md:text-3xl">
          {corporateBookersSection.heading}
        </h2>
        <p class="text-muted-foreground mt-4">{corporateBookersSection.body}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={corporateBookersSection.primaryCta.link}
            class="bg-secondary text-secondary-foreground inline-flex rounded-full px-5 py-2.5 text-sm font-medium no-underline"
            >{corporateBookersSection.primaryCta.label}</a
          ><a
            href={corporateEmail}
            class="border-secondary text-secondary inline-flex rounded-full border px-5 py-2.5 text-sm font-medium no-underline"
            >{corporateBookersSection.secondaryCta.label}</a>
        </div>
      </div>
      {
        corporateBookersSection.image && (
          <Image
            src={corporateBookersSection.image}
            alt="Corporate booker arranging business accommodation"
            class="aspect-4/3 w-full rounded-2xl object-cover"
          />
        )
      }
    </div>
  </Section>

  <Section className="mt-28">
    <VettingPreview
      heading={whyAcosaPreview.heading}
      body={whyAcosaPreview.body}
      essentials={essentials.map((e) => ({
        name: e.data.name,
        icon: e.data.icon,
      }))}
    />
  </Section>

  <Section className="mt-28">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-primary text-2xl font-bold md:text-3xl">
        {humanAssistanceSection.heading}
      </h2><p class="text-muted-foreground mt-3">
        {humanAssistanceSection.body}
      </p><a
        href={humanAssistanceLink}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-secondary text-secondary-foreground mt-6 inline-flex rounded-full px-5 py-2.5 text-sm font-medium no-underline"
        >{humanAssistanceSection.cta.label}</a>
    </div>
  </Section>

  <Section fullWidth className="m-0">
    <OwnerCta
      heading={propertyOwnersSection.heading || ownerCta.heading}
      body={propertyOwnersSection.body || ownerCta.body}
      buttonLabel={propertyOwnersSection.primaryCta.label ||
        ownerCta.buttonLabel}
      secondButtonLabel={propertyOwnersSection.secondaryCta.label ||
        ownerCta.secondButtonLabel}
      primaryHref={propertyOwnerPrimary}
      secondaryHref={propertyOwnerSecondary}
    />
  </Section>

  <Section className="mt-28 mb-28">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <div>
        <h2 class="text-primary text-2xl font-bold md:text-3xl">
          {closingSection.heading}
        </h2><p class="text-muted-foreground mt-3">{closingSection.body}</p><a
          href={closingLink}
          class="bg-secondary text-secondary-foreground mt-6 inline-flex rounded-full px-5 py-2.5 text-sm font-medium no-underline"
          >{closingSection.cta.label}</a>
      </div>{
        closingSection.image && (
          <Image
            src={closingSection.image}
            alt="A comfortable end to a business travel day"
            class="aspect-4/3 w-full rounded-2xl object-cover"
          />
        )
      }
    </div>
  </Section>
</Layout>
