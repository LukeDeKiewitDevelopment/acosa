---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '@/layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { PROPERTY_TYPES } from '@/lib/content';
import { Section } from '@/components/custom/section';
import {
  StaticAcosaImage,
  type ResolvedAcosaImage,
} from '@/components/custom/image';
import { ListPropertyForm } from '@/components/custom/list-property-form';

export const prerender = true;

const page = await getEntry('listYourPropertyPage', 'list-your-property');
if (!page) throw new Error('List Your Property page content not found');
const { hero, whoWeWorkWith, benefits, acosaStandards, formIntro, seo } = page.data;

// Cast: seoFields() in content.config.ts types image() as ZodTypeAny, which
// erases ImageMetadata from the inferred schema. The runtime value is one.
const ogImageUrl = seo?.ogImage
  ? (
      await getImage({
        src: seo.ogImage as ImageMetadata,
        width: 1200,
        height: 630,
      })
    ).src
  : undefined;

const hcaptchaSiteKey: string = import.meta.env.PUBLIC_HCAPTCHA_SITE_KEY ?? '';

// PROPERTY_TYPES lives in content.config.ts (server-only via astro:content), so
// it cannot be imported into the client island. Resolve the label/value options
// here on the server and pass them to the form as a prop.
const propertyTypes = Object.entries(PROPERTY_TYPES).map(([value, label]) => ({
  value,
  label,
}));

let heroImage: ResolvedAcosaImage | null = null;
if (hero.image) {
  const img = await getImage({
    src: hero.image,
    widths: [640, 1024, 1600],
    sizes: '100vw',
  });
  heroImage = {
    src: img.src,
    srcSet: img.srcSet.attribute || undefined,
    sizes: img.attributes.sizes,
    width: img.attributes.width,
    height: img.attributes.height,
  };
}

const showWhoWeWorkWith = Boolean(whoWeWorkWith.heading || whoWeWorkWith.body);
const showAcosaStandards = Boolean(acosaStandards.heading || acosaStandards.body);
const hasBenefits = benefits.length > 0;
---

<Layout
  title={seo?.title || 'List Your Property | Acosa'}
  description={seo?.description ||
    'Apply to list your property with Acosa and reach vetted business travellers.'}
  ogImage={ogImageUrl}
>
  <Section className="mt-28">
    <h1 class="text-primary text-2xl font-bold md:text-3xl lg:text-4xl">
      {hero.heading}
    </h1>
    {
      hero.subheading && (
        <p class="text-muted-foreground mt-2 text-sm md:text-base">
          {hero.subheading}
        </p>
      )
    }
    {
      heroImage && (
        <div class="mt-6 overflow-hidden rounded-2xl">
          <StaticAcosaImage
            {...heroImage}
            alt=""
            className="aspect-21/9 w-full object-cover"
          />
        </div>
      )
    }
  </Section>

  {
    showWhoWeWorkWith && (
      <Section className="mt-16">
        {whoWeWorkWith.heading && (
          <h2 class="text-primary text-xl font-bold md:text-2xl">
            {whoWeWorkWith.heading}
          </h2>
        )}
        {whoWeWorkWith.body && (
          <p class="text-muted-foreground">{whoWeWorkWith.body}</p>
        )}
      </Section>
    )
  }

  {
    hasBenefits && (
      <Section className="mt-16">
        <h2 class="text-primary text-xl font-bold md:text-2xl">Benefits</h2>
        <ul
          role="list"
          class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
        >
          {benefits.map((b) => (
            <li class="bg-card rounded-xl border p-5 shadow-sm">
              <h3 class="text-primary font-semibold">{b.title}</h3>
              {b.detail && (
                <p class="text-muted-foreground mt-1 text-sm">{b.detail}</p>
              )}
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {
    showAcosaStandards && (
      <Section className="mt-16">
        {acosaStandards.heading && (
          <h2 class="text-primary text-xl font-bold md:text-2xl">
            {acosaStandards.heading}
          </h2>
        )}
        {acosaStandards.body && (
          <p class="text-muted-foreground">{acosaStandards.body}</p>
        )}
      </Section>
    )
  }

  <Section className="mt-16 mb-28">
    <div class="mx-auto w-full max-w-2xl">
      <h2 class="text-primary text-xl font-bold md:text-2xl">
        Apply to List Your Property
      </h2>
      {
        formIntro && (
          <p class="text-muted-foreground mt-2">{formIntro}</p>
        )
      }
      <div class="mt-6">
        <ListPropertyForm
          client:load
          hcaptchaSiteKey={hcaptchaSiteKey}
          propertyTypes={propertyTypes}
        />
      </div>
    </div>
  </Section>
</Layout>
