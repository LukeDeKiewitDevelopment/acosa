---
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "@/layouts/Layout.astro";
import { getEntry } from "astro:content";
import {
  getSiteSettings,
  resolveCtaLink,
  buildNodeSummaries,
  LISTING_WHATSAPP_MESSAGE,
  PROPERTY_APPLICATION_EMAIL_BODY,
  PROPERTY_APPLICATION_EMAIL_SUBJECT,
} from "@/lib/content";
import { Section } from "@/components/custom/section";
import { SectionHeader } from "@/components/custom/section-header";
import { Hero } from "@/components/custom/hero";
import { CtaLink } from "@/components/custom/cta-link";
import { TextLink } from "@/components/custom/text-link";
import {
  BadgeCheck,
  BadgePercent,
  ChevronDown,
  House,
  Info,
  PenLine,
  Sparkles,
  ChartColumn,
  Check,
  ClipboardCheck,
  Images,
  MapPin,
  Megaphone,
  RefreshCw,
  Rocket,
  Search,
  Send,
  Store,
} from "lucide-react";
import { IconMark } from "@/components/custom/icon-mark";
import { ReachRings, SaMap } from "@/components/custom/map-graphics";
import { SectionNav } from "@/components/custom/section-nav";

export const prerender = true;

/* For Properties — Creative Direction Blueprint, Page 07 (highest visual
   priority) and the pre-launch addendum §11 pacing:
   cinematic hero (desire) → editorial 50/50 (qualification) → image +
   benefits grid (value) → curation feature (trust) → typography (beyond the
   listing) → pricing panel (commercial decision) → compact support strip →
   image + process → final conversion (action). One application CTA closes
   the journey, so there are no stacked duplicates. */

const page = await getEntry("listYourPropertyPage", "list-your-property");
if (!page) throw new Error("List Your Property page content not found");
const {
  hero,
  whoWeWorkWithSection,
  valueSection,
  curationSection,
  promotionalVisibilitySection,
  pricingSection,
  listingUpdatesSection,
  howToJoinSection,
  finalCta,
  seo,
} = page.data;
const settings = await getSiteSettings();
const uiCopy = settings.data.uiCopy.listYourProperty;
const mapNodes = await buildNodeSummaries("gauteng");
const ctaOptions = {
  email: settings.data.enquiryEmail,
  whatsappNumber: settings.data.defaultWhatsapp,
  whatsappMessage: LISTING_WHATSAPP_MESSAGE,
};
const applicationOptions = {
  ...ctaOptions,
  emailSubject: PROPERTY_APPLICATION_EMAIL_SUBJECT,
  emailBody: PROPERTY_APPLICATION_EMAIL_BODY,
};
const heroPrimaryHref = resolveCtaLink(hero.primaryCta.link, ctaOptions);
const heroSecondaryHref = resolveCtaLink(hero.secondaryCta.link, ctaOptions);
const pricingHref = resolveCtaLink(pricingSection.cta.link, applicationOptions);
const applicationHref = resolveCtaLink(
  howToJoinSection.cta.link,
  applicationOptions,
);
const questionHref = resolveCtaLink(finalCta.secondaryCta.link, ctaOptions);
const curationHref = resolveCtaLink(curationSection.cta.link, ctaOptions);
const promoHref = promotionalVisibilitySection.cta
  ? resolveCtaLink(promotionalVisibilitySection.cta.link, ctaOptions)
  : undefined;

// One icon per listing benefit, matched on the CMS title (fallback: check).
const benefitIcons: [RegExp, typeof Check][] = [
  [/profile/i, ClipboardCheck],
  [/gallery/i, Images],
  [/node/i, MapPin],
  [/search|filter/i, Search],
  [/convenience/i, Store],
  [/enquir/i, Send],
  [/commission/i, BadgePercent],
  [/launch/i, Rocket],
  [/promot/i, Megaphone],
  [/asset/i, BadgeCheck],
  [/snapshot|performance/i, ChartColumn],
];
const benefitIcon = (title: string) =>
  benefitIcons.find(([pattern]) => pattern.test(title))?.[1] ?? Check;

// Refresh items from the CMS, matched to an icon (fallback: check).
const refreshIcon = (item: string) =>
  /image|gallery|photo/i.test(item)
    ? Images
    : /copy|descript|text/i.test(item)
      ? PenLine
      : /facilit/i.test(item)
        ? Sparkles
        : Check;

// "R4,290" + "/year" -> "R358", so the annual plan can be compared monthly.
const monthlyEquivalent = (plan: { price: string; period: string }) => {
  if (!/year|annual/i.test(plan.period)) return null;
  const amount = Number(plan.price.replace(/[^0-9.]/g, ""));
  return amount > 0
    ? `R${Math.round(amount / 12).toLocaleString("en-ZA")}`
    : null;
};

// The monthly partner rate is the highlighted offer (R389 at launch).
const isPartnerPlan = (plan: { tier: string; price: string; period: string }) =>
  /partner/i.test(plan.tier) && /month/i.test(plan.period);

// Cast: seoFields() in content.config.ts types image() as ZodTypeAny, which
// erases ImageMetadata from the inferred schema. The runtime value is one.
const ogImageUrl = seo?.ogImage
  ? (
      await getImage({
        src: seo.ogImage as ImageMetadata,
        width: 1200,
        height: 630,
      })
    ).src
  : undefined;
---

<Layout
  title={seo?.title || "List Your Property | ACOSA"}
  description={seo?.description ||
    "Apply to list your property with ACOSA and reach vetted business travellers."}
  ogImage={ogImageUrl}
  whatsappMessage={LISTING_WHATSAPP_MESSAGE}
>
  {/* 01 — Desire: the hero sells the opportunity. */}
  <Hero
    size="cinematic"
    emphasizeBody
    align="left"
    eyebrow={hero.eyebrow}
    heading={hero.heading}
    body={hero.body}
    image={hero.image}
    imageAlt="An independent accommodation host welcoming a business traveller"
    imageClassName="object-[62%_center] sm:object-[60%_center] lg:object-[58%_center] motion-safe:animate-[acosa-zoom_10s_ease-out_both]"
    primaryCta={{ label: hero.primaryCta.label, href: heroPrimaryHref }}
    secondaryCta={{
      label: hero.secondaryCta.label,
      href: heroSecondaryHref,
      external: hero.secondaryCta.link === "whatsapp",
    }}
  />

  <SectionNav
    client:load
    items={[
      { id: "why-list", label: uiCopy.whoWeWorkWithNav },
      { id: "whats-included", label: uiCopy.includedNav },
      { id: "acosa-review", label: uiCopy.standardsNav },
      { id: "visibility", label: uiCopy.visibilityNav },
      { id: "pricing", label: uiCopy.pricingNav },
      { id: "apply", label: uiCopy.joinNav },
    ]}
  />

  {/* 02 — Qualification: selectivity, as an editorial 50/50. */}
  <Section id="why-list">
    <div
      class="grid items-center gap-10 md:grid-cols-[1.15fr_0.85fr] lg:gap-20"
    >
      {
        whoWeWorkWithSection.image && (
          <div class="relative pb-10">
            <Image
              src={whoWeWorkWithSection.image}
              format="webp"
              quality={75}
              loading="lazy"
              alt="An independent accommodation owner preparing her guesthouse"
              widths={[480, 800, 1200, 1408]}
              sizes="(min-width: 768px) 58vw, 100vw"
              class="bg-muted aspect-[4/3] w-full rounded-xl object-contain"
            />
            {whoWeWorkWithSection.secondaryImage && (
              <Image
                src={whoWeWorkWithSection.secondaryImage}
                format="webp"
                quality={75}
                loading="lazy"
                alt="A relaxed guest lounge opening onto a terrace with mountain views"
                widths={[400, 800]}
                sizes="(min-width: 1024px) 20vw, 40vw"
                class="ring-background absolute bottom-0 left-0 block aspect-4/3 w-[44%] rounded-xl object-cover ring-8"
              />
            )}
          </div>
        )
      }
      <div class="flex flex-col gap-8">
        <SectionHeader
          eyebrow={whoWeWorkWithSection.eyebrow}
          title={whoWeWorkWithSection.heading}
          lead={whoWeWorkWithSection.body || null}
          underline
        />
        <div class="flex flex-col gap-4">
          <p class="text-foreground text-sm font-semibold">
            {uiCopy.worksWithIntro}
          </p>
          <ul
            class="divide-border border-border flex flex-col divide-y border-y"
          >
            {
              whoWeWorkWithSection.properties.map((quality, index) => (
                <li
                  data-reveal
                  style={`--reveal-index: ${index}`}
                  class="flex items-start gap-3 py-3.5"
                >
                  <Check
                    className="text-gold-ink mt-1 size-4 shrink-0"
                    aria-hidden="true"
                  />
                  <span class="text-foreground/90 text-[0.9375rem] leading-relaxed">
                    {quality}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="grid grid-cols-[auto_1fr] items-start gap-4">
          <span
            aria-hidden="true"
            class="border-gold/40 text-gold flex size-14 items-center justify-center rounded-xl border"
          >
            <BadgeCheck className="size-7" />
          </span>
          <div class="flex flex-col items-start gap-2">
            <p class="type-h3">{whoWeWorkWithSection.highlight}</p>
            <p class="type-small">{whoWeWorkWithSection.note}</p>
            <TextLink
              label={uiCopy.whyAcosaLabel}
              href={uiCopy.whyAcosaLink}
              trackingKey="listing_why_acosa_click"
            />
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* 03 — Value: image + scannable benefits grid. */}
  <Section id="whats-included" tone="warm">
    <div
      class="grid items-center gap-10 md:grid-cols-2 lg:grid-cols-[1fr_1.1fr] lg:gap-20"
    >
      <SectionHeader
        eyebrow={valueSection.eyebrow}
        title={valueSection.heading}
        lead={valueSection.body}
        emphasizeLead
        underline
      />
      {
        valueSection.image && (
          <div class="relative mx-auto w-full max-w-xl pb-16">
            <Image
              src={valueSection.image}
              format="webp"
              quality={75}
              loading="lazy"
              alt="A property owner reviewing his ACOSA listing"
              widths={[480, 800, 1200, 1408]}
              sizes="(min-width: 768px) 55vw, 100vw"
              class="aspect-[4/3] w-full rounded-xl object-cover object-[55%_center] lg:aspect-video"
            />
            <div class="ring-background bg-navy absolute right-0 bottom-0 aspect-[4/3] w-[56%] overflow-hidden rounded-xl p-3 ring-4 sm:w-[48%] sm:p-4 sm:ring-8 lg:p-6">
              <SaMap
                pins={mapNodes
                  .filter(
                    (node) =>
                      node.longitude !== undefined &&
                      node.latitude !== undefined,
                  )
                  .map((node) => ({
                    longitude: node.longitude!,
                    latitude: node.latitude!,
                  }))}
                className="text-ivory"
              />
            </div>
          </div>
        )
      }
    </div>
    <ul
      class="mt-14 grid gap-x-10 gap-y-8 sm:grid-cols-2 md:mt-20 lg:grid-cols-3"
    >
      {
        valueSection.includes.map((item, index) => (
          <li
            data-reveal
            style={`--reveal-index: ${index % 3}`}
            class="group border-sage hover:border-gold flex flex-col gap-3 border-t pt-6 transition-[border-color,translate] duration-300 hover:-translate-y-1 motion-reduce:hover:translate-y-0"
          >
            <IconMark
              icon={benefitIcon(item.title)}
              size="sm"
              className="group-hover:bg-gold group-hover:text-navy transition-colors duration-300"
            />
            <h3 class="type-h3">{item.title}</h3>
            <p class="type-small">{item.detail}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* 04 — Trust: curation justifies trust. Navy feature. */}
  <Section id="acosa-review" tone="navy">
    <div class="grid items-start gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-20">
      <div class="relative pb-10 sm:pb-0">
        {
          curationSection.image && (
            <Image
              src={curationSection.image}
              format="webp"
              quality={75}
              loading="lazy"
              alt="A business traveller unpacking in a guesthouse room"
              widths={[480, 800, 1200, 1408]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              class="aspect-4/3 w-full rounded-xl object-cover object-[60%_center] lg:aspect-5/4"
            />
          )
        }
        {
          curationSection.secondaryImage && (
            <Image
              src={curationSection.secondaryImage}
              format="webp"
              quality={75}
              loading="lazy"
              alt="A professional hospitality team preparing a property"
              widths={[400, 800]}
              sizes="(min-width: 1024px) 20vw, 40vw"
              class="ring-navy absolute -right-3 -bottom-10 block aspect-4/3 w-[42%] rounded-xl object-cover object-[45%_center] ring-8 lg:-right-8"
            />
          )
        }
      </div>
      <div class="flex flex-col gap-8 sm:pt-6 lg:pt-0">
        <SectionHeader
          eyebrow={curationSection.eyebrow}
          title={curationSection.heading}
          lead={curationSection.body}
          emphasizeLead
          accent
          underlineWord="matters"
        />
        <ul class="grid grid-cols-2 gap-x-6 gap-y-3">
          {
            curationSection.criteria.map((criterion, index) => (
              <li
                data-reveal
                style={`--reveal-index: ${index % 2}`}
                class="text-foreground flex items-center gap-2.5 text-[0.9375rem]"
              >
                <Check
                  className="text-gold size-4 shrink-0"
                  aria-hidden="true"
                />
                {criterion}
              </li>
            ))
          }
        </ul>
        <div class="border-border flex gap-4 border-t pt-7">
          <BadgeCheck
            className="text-gold mt-0.5 size-6 shrink-0"
            aria-hidden="true"
          />
          <div class="flex flex-col gap-2">
            <h3 class="type-h3">{curationSection.approvedHeading}</h3>
            <p class="type-small">{curationSection.approvedBody}</p>
          </div>
        </div>
        <CtaLink
          label={curationSection.cta.label}
          href={curationHref}
          variant="link"
          icon="arrow"
          trackingKey="listing_curation_click"
        />
      </div>
    </div>
  </Section>

  {/* Beyond the listing: reaching the right audience. */}
  <Section id="visibility">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-20">
      <div class="flex flex-col gap-6" data-reveal>
        <SectionHeader
          eyebrow={promotionalVisibilitySection.eyebrow}
          title={promotionalVisibilitySection.heading}
          lead={promotionalVisibilitySection.body}
          emphasizeLead
          underline
        />
        {
          promotionalVisibilitySection.note && (
            <details class="group border-border bg-card rounded-lg border [&_summary::-webkit-details-marker]:hidden">
              <summary class="text-foreground focus-visible:outline-ring flex cursor-pointer list-none items-center justify-between gap-4 px-4 py-3 text-sm font-semibold focus-visible:outline-2">
                <span class="flex items-center gap-2.5">
                  <Info className="text-gold-ink size-4" aria-hidden="true" />
                  Good to know
                </span>
                <ChevronDown
                  className="size-4 transition-transform duration-200 group-open:rotate-180"
                  aria-hidden="true"
                />
              </summary>
              <p class="type-small border-border border-t px-4 py-3">
                {promotionalVisibilitySection.note}
              </p>
            </details>
          )
        }
        {
          promotionalVisibilitySection.cta && promoHref && (
            <CtaLink
              label={promotionalVisibilitySection.cta.label}
              href={promoHref}
              variant="link"
              icon="arrow"
            />
          )
        }
      </div>
      <div data-reveal style="--reveal-index: 1">
        <div
          class="surface-ivory relative mx-auto aspect-square w-full max-w-md overflow-hidden rounded-2xl"
        >
          <ReachRings className="text-navy absolute inset-0 m-auto w-[92%]" />
          <span
            class="bg-navy text-gold absolute inset-0 m-auto flex size-20 items-center justify-center rounded-xl shadow-[0_18px_40px_-18px_rgb(5_10_60/0.6)]"
          >
            <House className="size-8" aria-hidden="true" />
          </span>
        </div>
      </div>
    </div>
  </Section>

  {
    /* 05 — Commercial decision: restrained typography, clear price hierarchy.
      The R389 partner rate is identified without hiding R499 or R4,290. */
  }
  <Section
    id="pricing"
    spacing="none"
    fullWidth
    className="surface-navy relative isolate overflow-hidden"
  >
    {
      promotionalVisibilitySection.image && (
        <Image
          src={promotionalVisibilitySection.image}
          format="webp"
          quality={75}
          loading="lazy"
          alt=""
          widths={[480, 800, 1200, 1408, 1920]}
          sizes="100vw"
          class="absolute inset-0 z-0 h-full w-full object-cover object-[62%_center]"
        />
      )
    }
    <div aria-hidden="true" class="bg-navy/55 absolute inset-0 z-10"></div>
    <div
      class="container-page relative z-20 flex flex-col gap-12 py-14 md:gap-14 md:py-20"
    >
      <SectionHeader
        eyebrow={pricingSection.eyebrow}
        title={pricingSection.heading}
        align="center"
        underline
        accent
        titleClassName="text-white"
      />
      <ul
        style="--foreground: #050a3c; --muted-foreground: #695f54;"
        class="grid gap-4 md:grid-cols-3 md:gap-5"
      >
        {
          pricingSection.pricing.map((plan, index) => {
            const partner = isPartnerPlan(plan);
            const perMonth = monthlyEquivalent(plan);
            return (
              <li
                data-reveal
                style={`--reveal-index: ${index}`}
                class:list={[
                  "relative flex flex-col gap-5 rounded-xl border bg-white/95 p-7 backdrop-blur-sm transition-[box-shadow,border-color] duration-300 hover:shadow-[0_28px_60px_-34px_rgb(5_10_60/0.5)] md:p-8",
                  !partner && "hover:border-foreground/30",
                  partner
                    ? "border-gold shadow-[0_24px_50px_-30px_rgb(5_10_60/0.45)] md:-my-3 md:py-11"
                    : "border-border",
                ]}
              >
                {partner && (
                  <p class="bg-gold text-navy absolute -top-3 left-7 rounded-md px-2.5 py-1 text-[0.6875rem] font-semibold tracking-[0.12em] uppercase md:left-8">
                    Partner offer
                  </p>
                )}
                <h3 class="type-h3">{plan.tier}</h3>
                <p class="flex items-baseline gap-1.5">
                  <span class="font-heading text-foreground text-[2.75rem] leading-none font-semibold tracking-tight">
                    {plan.price}
                  </span>
                  <span class="text-muted-foreground text-sm">
                    {plan.period}
                  </span>
                </p>
                {perMonth && (
                  <p class="text-gold-ink -mt-2 text-sm font-semibold">
                    Works out to {perMonth} a month.
                  </p>
                )}
                <p class="type-small border-border border-t pt-5">
                  {plan.detail}
                </p>
              </li>
            );
          })
        }
      </ul>
      <div class="flex flex-col items-center gap-3 text-center">
        <CtaLink
          label={pricingSection.cta.label}
          href={pricingHref}
          variant="primary"
          size="lg"
          icon="arrow"
          trackingKey="listing_pricing_apply_click"
        />
      </div>
    </div>
  </Section>

  {/* Listing support: what a refresh covers, as a feature card. */}
  <Section spacing="tight" id="listing-updates">
    <div
      class:list={[
        "grid items-stretch gap-6",
        listingUpdatesSection.image && "md:grid-cols-2",
      ]}
    >
      {
        listingUpdatesSection.image && (
          <div class="relative pb-10">
            <Image
              src={listingUpdatesSection.image}
              format="webp"
              quality={75}
              loading="lazy"
              alt="A guesthouse room prepared for guests"
              widths={[480, 800, 1200, 1408]}
              sizes="(min-width: 768px) 50vw, 100vw"
              class="aspect-4/3 h-full w-full rounded-xl object-cover object-[58%_center] md:aspect-auto"
            />
            {listingUpdatesSection.secondaryImage && (
              <Image
                src={listingUpdatesSection.secondaryImage}
                format="webp"
                quality={75}
                loading="lazy"
                alt="A welcoming property entrance with an open front door"
                widths={[400, 800]}
                sizes="(min-width: 1024px) 20vw, 40vw"
                class="ring-background absolute right-0 bottom-0 block aspect-4/3 w-[40%] rounded-xl object-cover ring-8"
              />
            )}
          </div>
        )
      }
      <div
        class="surface-navy relative isolate flex flex-col gap-6 overflow-hidden rounded-xl px-6 py-8 sm:px-8 sm:py-10"
      >
        <RefreshCw
          className="text-gold/15 absolute -top-6 -right-6 size-44"
          aria-hidden="true"
        />
        <div class="relative flex max-w-3xl flex-col gap-4">
          <SectionHeader
            eyebrow={uiCopy.listingSupportEyebrow}
            title={listingUpdatesSection.heading}
            underlineWord="current"
            accent
            titleClassName="text-white"
            className="max-w-3xl"
          />
          <p class="type-lead text-white/90">{listingUpdatesSection.body}</p>
        </div>
        {
          listingUpdatesSection.refreshIncludes.length > 0 && (
            <div class="flex flex-col gap-3">
              <p class="eyebrow-accent">A refresh can include</p>
              <ul class="grid gap-3 sm:grid-cols-3">
                {listingUpdatesSection.refreshIncludes.map((item) => {
                  const Icon = refreshIcon(item);
                  return (
                    <li class="bg-navy/40 flex flex-col gap-3 rounded-lg border border-white/25 p-4 text-white backdrop-blur-sm transition-transform duration-200 hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0">
                      <Icon className="text-gold size-5" aria-hidden="true" />
                      <span class="text-sm font-medium first-letter:uppercase">
                        {item}
                      </span>
                    </li>
                  );
                })}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </Section>

  {/* 06 — Action: image + process, then one concluding application. */}
  <Section id="apply" tone="ivory">
    <div
      class="grid items-start gap-12 md:grid-cols-2 lg:grid-cols-[1fr_1.05fr] lg:gap-20"
    >
      {
        howToJoinSection.image && (
          <Image
            src={howToJoinSection.image}
            format="webp"
            quality={75}
            loading="lazy"
            alt="A host welcoming a returning business guest"
            widths={[480, 800, 1200, 1408]}
            sizes="(min-width: 768px) 50vw, 100vw"
            class="aspect-4/3 w-full rounded-xl object-cover object-[50%_center] md:sticky md:top-28 md:aspect-4/5"
          />
        )
      }
      <div class="flex flex-col gap-10">
        <div class="flex flex-col items-start gap-4">
          <p class="eyebrow">{howToJoinSection.eyebrow}</p>
          {
            settings.data.logos?.light?.image && (
              <Image
                src={settings.data.logos.light.image}
                format="webp"
                quality={75}
                loading="lazy"
                alt="ACOSA"
                widths={[160, 240, 320]}
                sizes="160px"
                class="h-auto w-40"
              />
            )
          }
          <h2 class="type-h2">
            {uiCopy.joinHeading}
          </h2>
        </div>
        <ol class="flex flex-col">
          {
            howToJoinSection.steps.map((step, index) => (
              <li data-step class="group relative flex gap-5 pb-8 last:pb-0">
                {index < howToJoinSection.steps.length - 1 && (
                  <span
                    aria-hidden="true"
                    class="bg-sage group-[.is-active]:bg-gold absolute top-11 bottom-1 left-4.75 w-px transition-colors duration-500"
                  />
                )}
                <span class="font-heading border-sage bg-card text-foreground group-[.is-active]:border-gold group-[.is-active]:bg-gold group-[.is-active]:text-navy flex size-10 shrink-0 items-center justify-center rounded-lg border text-sm font-semibold transition-colors duration-300">
                  {step.number}
                </span>
                <div class="flex flex-col gap-1 pt-2">
                  <h3 class="type-h3">{step.title}</h3>
                  <p class="type-small">{step.detail}</p>
                </div>
              </li>
            ))
          }
        </ol>

        {/* Final conversion: a conclusion, not another promotional panel. */}
        <div class="border-sage flex flex-col gap-5 border-t pt-10">
          <h2 class="type-h2">{finalCta.heading}</h2>
          <p class="type-lead">{finalCta.body}</p>
          <div
            class="mt-2 flex flex-col gap-5 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-7 sm:gap-y-4"
          >
            <CtaLink
              label={howToJoinSection.cta.label}
              href={applicationHref}
              variant="primary"
              size="lg"
              icon="email"
              trackingKey="listing_application_click"
            />
            <CtaLink
              label={finalCta.secondaryCta.label}
              href={questionHref}
              variant="link"
              icon={finalCta.secondaryCta.link === "whatsapp"
                ? "whatsapp"
                : "arrow"}
              external={questionHref.startsWith("http")}
              trackingKey="listing_question_click"
            />
          </div>
          <p class="type-small">
            We'll email you the official application form and explain the next
            steps.
          </p>
        </div>
      </div>
    </div>
  </Section>
</Layout>

<script>
  // Light up each join step as it scrolls past the middle of the screen.
  const steps = document.querySelectorAll("[data-step]");
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-active");
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -45% 0px" },
    );
    steps.forEach((step) => observer.observe(step));
  } else {
    steps.forEach((step) => step.classList.add("is-active"));
  }
</script>
