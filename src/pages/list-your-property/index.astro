---
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "@/layouts/Layout.astro";
import { getEntry } from "astro:content";
import {
  getSiteSettings,
  resolveCtaLink,
  LISTING_WHATSAPP_MESSAGE,
} from "@/lib/content";
import { Section } from "@/components/custom/section";
import { Hero } from "@/components/custom/hero";

import { CtaLink } from "@/components/custom/cta-link";
import { FeatureList } from "@/components/custom/feature-list";
import { SectionIcon } from "@/components/custom/section-icon";
import { BadgeCheck, Home, ClipboardCheck, Tag, RefreshCw, UserPlus } from "lucide-react";

export const prerender = true;

const page = await getEntry("listYourPropertyPage", "list-your-property");
if (!page) throw new Error("List Your Property page content not found");
const {
  hero,
  whoWeWorkWithSection,
  valueSection,
  curationSection,
  promotionalVisibilitySection,
  pricingSection,
  listingUpdatesSection,
  howToJoinSection,
  finalCta,
  seo,
} = page.data;
const settings = await getSiteSettings();
const ctaOptions = {
  email: settings.data.enquiryEmail,
  whatsappNumber: settings.data.defaultWhatsapp,
  whatsappMessage: LISTING_WHATSAPP_MESSAGE,
};
const heroPrimaryHref = resolveCtaLink(hero.primaryCta.link, ctaOptions);
const heroSecondaryHref = resolveCtaLink(hero.secondaryCta.link, ctaOptions);
const listingApplicationHref = resolveCtaLink(pricingSection.cta.link, {
  ...ctaOptions,
  emailSubject: "ACOSA Property Listing Application",
});
const joinApplicationHref = resolveCtaLink(howToJoinSection.cta.link, {
  ...ctaOptions,
  emailSubject: "ACOSA Property Listing Application",
});
const finalPrimaryHref = resolveCtaLink(finalCta.primaryCta.link, {
  ...ctaOptions,
  emailSubject: "ACOSA Property Listing Application",
});
const finalSecondaryHref = resolveCtaLink(
  finalCta.secondaryCta.link,
  ctaOptions,
);
const promoHref = promotionalVisibilitySection.cta
  ? resolveCtaLink(promotionalVisibilitySection.cta.link, ctaOptions)
  : undefined;

// Cast: seoFields() in content.config.ts types image() as ZodTypeAny, which
// erases ImageMetadata from the inferred schema. The runtime value is one.
const ogImageUrl = seo?.ogImage
  ? (
      await getImage({
        src: seo.ogImage as ImageMetadata,
        width: 1200,
        height: 630,
      })
    ).src
  : undefined;
---

<Layout
  title={seo?.title || "List Your Property | ACOSA"}
  description={seo?.description ||
    "Apply to list your property with ACOSA and reach vetted business travellers."}
  ogImage={ogImageUrl}
  whatsappMessage={LISTING_WHATSAPP_MESSAGE}
>
  <Hero
    eyebrow={hero.eyebrow}
    heading={hero.heading}
    body={hero.body}
    image={hero.image}
    imageAlt="Independent accommodation provider"
    imageClassName="object-[68%_center] md:object-[64%_center] lg:object-center"
    primaryCta={{ label: hero.primaryCta.label, href: heroPrimaryHref }}
    secondaryCta={{
      label: hero.secondaryCta.label,
      href: heroSecondaryHref,
      external: hero.secondaryCta.link === "whatsapp",
    }}
  />

  <div class="mx-auto mt-8 max-w-6xl px-4 md:px-6">
    <div class="grid gap-4 md:grid-cols-3">
      <div class="rounded-2xl border border-border bg-card p-5 shadow-sm">
        <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-muted-foreground">Who it suits</p>
        <h3 class="mt-3 text-lg font-semibold text-primary">Independent stays</h3>
        <p class="mt-2 text-sm text-muted-foreground">Boutique stays, guesthouses and executive rentals that care about the guest experience.</p>
      </div>
      <div class="rounded-2xl border border-border bg-card p-5 shadow-sm">
        <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-muted-foreground">What you get</p>
        <h3 class="mt-3 text-lg font-semibold text-primary">Relevant visibility</h3>
        <p class="mt-2 text-sm text-muted-foreground">A curated profile, practical property discovery and a clearer route to the right business travellers.</p>
      </div>
      <div class="rounded-2xl border border-border bg-card p-5 shadow-sm">
        <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-muted-foreground">How it works</p>
        <h3 class="mt-3 text-lg font-semibold text-primary">Simple and selective</h3>
        <p class="mt-2 text-sm text-muted-foreground">Apply, get reviewed, then go live when your property meets ACOSA's accommodation standards.</p>
      </div>
    </div>
  </div>

  <Section id="why-list" className="mt-16">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      {whoWeWorkWithSection.image && (
        <Image
          src={whoWeWorkWithSection.image}
          alt="An independent accommodation owner caring for her property"
          class="aspect-4/3 h-auto w-full rounded-2xl object-cover"
        />
      )}
      <div>
        <div class="flex items-center gap-3">
          <SectionIcon icon={Home} />
          <p class="text-muted-foreground text-xs font-semibold tracking-wider uppercase">
            {whoWeWorkWithSection.eyebrow}
          </p>
        </div>
        <h2 class="text-primary mt-2 text-2xl font-bold md:text-3xl">
          {whoWeWorkWithSection.heading}
        </h2>
        {whoWeWorkWithSection.body && (
          <p class="text-muted-foreground mt-3">{whoWeWorkWithSection.body}</p>
        )}
        <FeatureList
          className="mt-6"
          items={whoWeWorkWithSection.properties.map((property) => ({ text: property }))}
        />
        <p class="text-primary mt-6 font-semibold">
          {whoWeWorkWithSection.highlight}
        </p>
        <p class="text-muted-foreground mt-2 text-sm">
          {whoWeWorkWithSection.note}
        </p>
      </div>
    </div>
  </Section>

  <Section id="whats-included" className="mt-16 bg-muted/35 py-16 md:mt-24 md:py-20">
    <div class="mx-auto grid w-full max-w-7xl items-center gap-10 px-4 md:gap-16 md:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:px-8">
      {
        valueSection.image && (
          <Image
            src={valueSection.image}
            alt="ACOSA property visibility"
            class="aspect-4/3 w-full rounded-2xl object-cover"
          />
        )
      }
      <div>
        <div class="flex items-center gap-3">
          <SectionIcon icon={BadgeCheck} />
          <p class="text-muted-foreground text-xs font-semibold tracking-wider uppercase">
            {valueSection.eyebrow}
          </p>
        </div>
        <h2 class="text-primary mt-2 text-2xl font-bold md:text-3xl">
          {valueSection.heading}
        </h2>
        <p class="text-muted-foreground mt-3">{valueSection.body}</p>
        <FeatureList
          className="mt-6"
          items={valueSection.includes.map((item) => ({
            title: item.title,
            detail: item.detail,
            text: item.title,
          }))}
        />
      </div>
    </div>
  </Section>

  <Section id="acosa-review" className="mt-16 md:mt-24">
    <div class="grid items-center gap-10 lg:grid-cols-[1.25fr_0.9fr] lg:gap-16">
      <div class="grid gap-4 sm:grid-cols-[1.5fr_1fr] lg:grid-cols-[1.35fr_0.65fr] lg:items-end">
        {curationSection.image && (
          <Image
            src={curationSection.image}
            alt="ACOSA reviewing a guesthouse room"
            class="aspect-4/3 h-auto w-full rounded-2xl object-cover lg:aspect-5/4"
          />
        )}
        {curationSection.secondaryImage && (
          <Image
            src={curationSection.secondaryImage}
            alt="A professional hospitality team preparing a property"
            class="aspect-4/3 h-auto w-full rounded-2xl object-cover lg:mb-10 lg:aspect-4/5"
          />
        )}
      </div>
      <div>
        <div class="flex items-center gap-3">
          <SectionIcon icon={ClipboardCheck} />
          <p class="text-muted-foreground text-xs font-semibold tracking-wider uppercase">{curationSection.eyebrow}</p>
        </div>
        <h2 class="text-primary mt-2 text-2xl font-bold md:text-3xl">{curationSection.heading}</h2>
        <p class="text-muted-foreground mt-3">{curationSection.body}</p>
        <FeatureList
          className="mt-5"
          items={curationSection.criteria.map((item) => ({ text: item }))}
        />
        <div class="border-border mt-8 border-l-2 pl-4">
          <h3 class="text-primary font-semibold">{curationSection.approvedHeading}</h3>
          <p class="text-muted-foreground mt-2 text-sm">{curationSection.approvedBody}</p>
        </div>
        <CtaLink
          label={curationSection.cta.label}
          href={resolveCtaLink(curationSection.cta.link, ctaOptions)}
          variant="link"
          size="md"
          icon="arrow"
          className="mt-6"
        />
      </div>
    </div>
  </Section>

  <Section className="mt-16 md:mt-24">
    <div class="mx-auto max-w-3xl border-y border-border py-16 text-center md:py-20">
      <p class="text-muted-foreground text-xs font-semibold tracking-wider uppercase">{promotionalVisibilitySection.eyebrow}</p>
      <h2 class="text-primary text-2xl font-bold md:text-3xl">
        {promotionalVisibilitySection.heading}
      </h2><p class="text-muted-foreground mt-3">
        {promotionalVisibilitySection.body}
      </p><p class="text-muted-foreground mt-4 text-sm">
        {promotionalVisibilitySection.note}
      </p>
      {
        promotionalVisibilitySection.cta && promoHref && (
          <CtaLink
            label={promotionalVisibilitySection.cta.label}
            href={promoHref}
            variant="link"
            size="md"
            icon="arrow"
            className="mt-6"
          />
        )
      }
    </div>
  </Section>

  <Section id="pricing" className="mt-16 md:mt-24">
    <div class="mx-auto w-full max-w-5xl rounded-2xl bg-primary p-8 text-primary-foreground md:p-12">
        <div class="flex items-center gap-3">
          <SectionIcon icon={Tag} className="bg-secondary/20 text-secondary" />
          <p class="text-primary-foreground/70 text-xs font-semibold tracking-wider uppercase">
            {pricingSection.eyebrow}
          </p>
        </div>
        <h2 class="mt-2 text-2xl font-bold md:text-3xl">
          {pricingSection.heading}
        </h2><div class="mt-6 grid gap-4 md:grid-cols-3 md:mt-8">
        {
          pricingSection.pricing.map((plan) => (
            <article class:list={["rounded-lg border border-primary-foreground/20 bg-primary-foreground/10 p-5", plan.price === "R389" && "border-secondary ring-secondary/30 bg-primary-foreground/20 ring-2"]}>
              <>
                <h3 class="font-semibold">{plan.tier}</h3>
                <p class="mt-4 text-2xl font-bold">
                  {plan.price}
                  <span class="text-primary-foreground/70 text-sm font-normal">
                    {plan.period}
                  </span>
                </p>
                <p class="text-primary-foreground/75 mt-2 text-sm">{plan.detail}</p>
              </>
            </article>
          ))
        }
      </div><CtaLink
        label={pricingSection.cta.label}
        href={listingApplicationHref}
        variant="secondary"
        size="md"
        icon="arrow"
        className="mt-8"
      />
    </div>
  </Section>

  <Section className="mt-16">
    <div class="mx-auto max-w-3xl border-l-2 border-secondary pl-6 md:pl-8">
      <div class="flex items-center gap-3">
        <SectionIcon icon={RefreshCw} />
        <h2 class="text-primary text-2xl font-bold md:text-3xl">
          {listingUpdatesSection.heading}
        </h2>
      </div>
      <p class="text-muted-foreground mt-3">
        {listingUpdatesSection.body}
      </p>
      <FeatureList
        className="mt-5"
        items={listingUpdatesSection.refreshIncludes.map((item) => ({ text: item }))}
      />
    </div>
  </Section>

  <Section id="apply" className="mt-16 md:mt-24">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      {howToJoinSection.image && (
        <Image
          src={howToJoinSection.image}
          alt="A business traveller being welcomed by a host"
          class="aspect-4/3 h-auto w-full rounded-2xl object-cover"
        />
      )}
      <div>
        <div class="flex items-center gap-3">
          <SectionIcon icon={UserPlus} />
          <p class="text-muted-foreground text-xs font-semibold tracking-wider uppercase">
            {howToJoinSection.eyebrow}
          </p>
        </div><ol class="mt-6 space-y-4">
        {
          howToJoinSection.steps.map((step) => (
            <li class="flex gap-4">
              <>
                <span class="text-secondary font-bold">{step.number}</span>
                <div>
                  <>
                    <h3 class="text-primary font-semibold">{step.title}</h3>
                    <p class="text-muted-foreground text-sm">{step.detail}</p>
                  </>
                </div>
              </>
            </li>
          ))
        }
      </ol><CtaLink
        label={howToJoinSection.cta.label}
        href={joinApplicationHref}
        variant="secondary"
        size="md"
        icon="arrow"
        className="mt-6"
      />
      </div>
    </div></Section
  >

  <Section className="mt-16 mb-28 md:mt-24"
    ><div
      class="bg-primary text-primary-foreground mx-auto max-w-4xl rounded-2xl p-10 text-center shadow-xl md:p-14"
    >
      <h2 class="text-2xl font-bold md:text-3xl">{finalCta.heading}</h2><p
        class="mt-3"
      >
        {finalCta.body}
      </p><div class="mt-6 flex flex-wrap justify-center gap-3">
        <CtaLink
          label={finalCta.primaryCta.label}
          href={finalPrimaryHref}
          variant="inverted"
          size="md"
          icon="arrow"
        /><CtaLink
          label={finalCta.secondaryCta.label}
          href={finalSecondaryHref}
          variant="inverted"
          size="md"
          icon="whatsapp"
          external={finalCta.secondaryCta.link === "whatsapp"}
          className="border border-background/30 bg-transparent text-background hover:bg-background/10"
        />
      </div>
    </div></Section
  >
</Layout>
