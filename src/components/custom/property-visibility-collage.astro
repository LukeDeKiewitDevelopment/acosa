---
import type { PropertyListingItem } from "@/lib/content";
import { CtaLink } from "@/components/custom/cta-link";

type Props = {
  eyebrow: string;
  heading: string;
  body: string;
  image?: { src: string; srcSet?: string; sizes?: string };
  imageAlt?: string;
  properties: PropertyListingItem[];
  cta?: { label: string; href: string };
};

const {
  eyebrow,
  heading,
  body,
  image,
  imageAlt = "",
  properties,
  cta,
} = Astro.props;

const collageImages = [
  ...(image ? [{ ...image, alt: imageAlt }] : []),
  ...properties.slice(0, 3).map((property) => ({
    src: property.image.src,
    srcSet: property.image.srcSet,
    sizes: property.image.sizes,
    alt: property.imageAlt,
  })),
].slice(0, 4);
const headingTrimmed = heading.trim();
const headingLastSpace = headingTrimmed.lastIndexOf(" ");
const headingLead = headingTrimmed.slice(0, headingLastSpace + 1);
const headingFinalWord = headingTrimmed.slice(headingLastSpace + 1);
---

<section id="network" class="surface-navy overflow-hidden">
  <div
    class="container-page grid items-center gap-12 py-14 md:py-20 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20"
  >
    <div class="flex max-w-xl flex-col gap-5">
      <p class="eyebrow-accent">{eyebrow}</p>
      <h2 class="type-h2 text-white">
        {headingLead}<span class="accent-underline">{headingFinalWord}</span>
      </h2>
      <p class="type-lead text-white/85">{body}</p>
      {cta && <CtaLink label={cta.label} href={cta.href} variant="secondary" icon="arrow" />}
    </div>

    <div
      class="grid aspect-[4/3] grid-cols-2 grid-rows-2 gap-3"
      aria-label="A selection of live ACOSA properties"
    >
      {
        collageImages.map((collageImage, index) => (
          <a
            href={
              index === 0 && image
                ? "/list-your-property"
                : `/properties/${properties[index - (image ? 1 : 0)]?.id || ""}`
            }
            class:list={[
              "group relative overflow-hidden rounded-xl",
              index === 0 && "row-span-2",
            ]}
            data-acosa-track="network_collage_image_click"
          >
            <img
              src={collageImage.src}
              srcset={collageImage.srcSet}
              sizes={collageImage.sizes || "(min-width: 1024px) 30vw, 50vw"}
              alt={collageImage.alt}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <span aria-hidden="true" class="absolute inset-0 bg-navy/10 transition-colors group-hover:bg-navy/0"></span>
          </a>
        ))
      }
    </div>
  </div>
</section>
