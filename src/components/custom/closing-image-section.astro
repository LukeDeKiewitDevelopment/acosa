---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { CtaLink } from "@/components/custom/cta-link";

type Action = {
  label: string;
  href: string;
  variant?: "primary" | "secondary" | "link";
  icon?: "arrow" | "whatsapp" | "email" | "phone" | "external" | "none";
  external?: boolean;
  trackingKey?: string;
};

type Props = {
  id?: string;
  eyebrow?: string;
  heading: string;
  underlineHeading?: boolean;
  body: string;
  image: ImageMetadata;
  imagePosition?: "center" | "top";
  mobileImageFit?: "cover" | "contain";
  desktopAspectRatio?: "video";
  imageAlt: string;
  actions: Action[];
};

const {
  id,
  eyebrow,
  heading,
  underlineHeading = false,
  body,
  image,
  imagePosition = "center",
  mobileImageFit = "cover",
  desktopAspectRatio = "video",
  imageAlt,
  actions,
} = Astro.props;
const lastSpace = heading.trim().lastIndexOf(" ");
const headingLead = heading.trim().slice(0, lastSpace + 1);
const headingFinalWord = heading.trim().slice(lastSpace + 1);
---

<section
  id={id}
  class:list={[
    "surface-navy relative isolate overflow-hidden",
    desktopAspectRatio === "video" && "md:aspect-video",
  ]}
>
  <Image
    src={image}
    format="webp"
    quality={75}
    loading="lazy"
    alt={imageAlt}
    widths={[480, 800, 1200, 1408, 1920]}
    sizes="100vw"
    class:list={[
      "absolute inset-0 z-0 h-full w-full object-[72%_center] md:object-cover",
      mobileImageFit === "contain" ? "object-contain" : "object-cover",
      imagePosition === "top" && "md:object-[72%_top]",
    ]}
  />
  <div
    aria-hidden="true"
    class="from-navy/90 via-navy/60 to-navy/10 absolute inset-0 z-10 bg-linear-to-t md:bg-linear-to-r md:to-transparent"
  >
  </div>
  <div
    class:list={[
      "container-page relative z-20 flex min-h-120 items-end py-14 md:min-h-136 md:items-center md:py-20",
      desktopAspectRatio === "video" && "md:absolute md:inset-0 md:min-h-0",
    ]}
  >
    <div class="flex max-w-lg flex-col gap-5">
      {eyebrow && <p class="eyebrow-accent">{eyebrow}</p>}
      <h2 class="type-h2 text-white">
        {
          underlineHeading ? (
            <>
              {headingLead}
              <span class="accent-underline">{headingFinalWord}</span>
            </>
          ) : (
            heading
          )
        }
      </h2>
      <p class="type-lead text-white/85">{body}</p>
      <div class="mt-2 flex flex-wrap items-center gap-x-7 gap-y-4">
        {
          actions.map((action) => (
            <CtaLink
              {...action}
              className={action.variant === "link" ? "text-white" : undefined}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>
